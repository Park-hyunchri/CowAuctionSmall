<Window x:Class="GAMSTest.Views.ControlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GAMS 테스트 제어" Icon="../app.ico" Width="460" Height="210" Background="#1E1E1E" Foreground="#EEEEEE" WindowStartupLocation="Manual">
  <Window.Resources><Style TargetType="Button"><Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="7,4"/><Setter Property="Background" Value="#333333"/><Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="BorderBrush" Value="#555555"/></Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEEEEE"/></Style></Window.Resources>
  <Grid Margin="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
      <Grid Margin="0,0,0,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="상태 제어" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <Button Grid.Row="0" Grid.Column="1" Content="뷰 페이지" Command="{Binding StartCycleCommand}" HorizontalAlignment="Left" MinWidth="65" Height="26" Margin="0,0,0,6"/>
        <Button Grid.Row="1" Grid.Column="0" Content="번호" Command="{Binding ShowBoardNumberCommand}" HorizontalAlignment="Left" Width="50" Height="26"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="진행" Command="{Binding ShowRun1Command}" Width="45" Height="26" Margin="0,0,4,0"/>
          <Button Content="유전" Command="{Binding ShowRun2Command}" Width="45" Height="26" Margin="0,0,4,0"/>
          <Button Content="유찰" Command="{Binding ShowUnsoldCommand}" Width="45" Height="26" Margin="0,0,4,0"/>
          <Button Content="낙찰" Command="{Binding ShowSoldCommand}" Width="45" Height="26" Margin="0,0,4,0"/>
        </StackPanel>
      </Grid>
      <TextBlock Text="RGB 단색" FontWeight="Bold" Margin="0,0,0,3"/>
      <WrapPanel><Button Content="레드" Foreground="#FF5252" Command="{Binding Red}"/><Button Content="그린" Foreground="#4CAF50" Command="{Binding Green}"/><Button Content="블루" Foreground="#448AFF" Command="{Binding Blue}"/><Button Content="화이트" Foreground="#FFFFFF" Command="{Binding White}"/><Button Content="블랙" Foreground="#888888" Command="{Binding Black}"/></WrapPanel>
      <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="밝기" VerticalAlignment="Center" Margin="0,0,6,0"/><Slider Grid.Column="1" Width="190" Minimum="0" Maximum="255" Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}"/></Grid>
      <TextBlock Text="{Binding Brightness}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
    </StackPanel>
    <Button Grid.Column="1" Content="출하 AMS" FontSize="17" FontWeight="Bold" Width="95" Height="68" Margin="10,0,12,0" Padding="2" Foreground="White" Background="#2A2A2E" BorderBrush="#007ACC" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Click="LaunchCowAuction"/>
  </Grid>
</Window>
