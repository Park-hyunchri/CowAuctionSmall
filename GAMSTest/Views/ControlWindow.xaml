<Window x:Class="GAMSTest.Views.ControlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GAMS 테스트 제어" Width="560" Height="220" Background="#1E1E1E" Foreground="#EEEEEE" WindowStartupLocation="Manual">
  <Window.Resources><Style TargetType="Button"><Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="8,4"/><Setter Property="Background" Value="#333333"/><Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="BorderBrush" Value="#555555"/></Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEEEEE"/></Style></Window.Resources>
  <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="상태 제어" FontWeight="Bold" Margin="0,0,0,4"/><WrapPanel><Button Content="번호" Command="{Binding Numbers}"/><Button Content="뷰 페이지" Command="{Binding Pages}"/></WrapPanel><TextBlock Text="RGB 단색" FontWeight="Bold" Margin="0,10,0,4"/><WrapPanel><Button Content="레드" Foreground="#FF5252" Command="{Binding Red}"/><Button Content="그린" Foreground="#4CAF50" Command="{Binding Green}"/><Button Content="블루" Foreground="#448AFF" Command="{Binding Blue}"/><Button Content="화이트" Foreground="#FFFFFF" Command="{Binding White}"/><Button Content="블랙" Foreground="#888888" Command="{Binding Black}"/></WrapPanel><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="밝기" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}"/></Grid><TextBlock Text="{Binding Brightness}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="운영 프로그램&#x0a;실행" Width="90" Height="60" Foreground="White" Background="#2A2A2E" BorderBrush="#007ACC" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Click="LaunchCowAuction"/></Grid>
</Window>
