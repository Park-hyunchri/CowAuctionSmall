<UserControl x:Class="CowAuctionSmall.Views.Size128_64.AuctionSold_64"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_64"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             d:DesignHeight="64" d:DesignWidth="128"
             mc:Ignorable="d" 
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased" >
             

    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        
        <!-- 목차 스타일 -->
        <Style x:Key="BasicStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="lime"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
    </UserControl.Resources>

    <Border BorderBrush="Blue" BorderThickness="2">
        <Grid Background="Black">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="2" Grid.RowSpan="2"  
                Text="낙찰" Foreground="Violet" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="27" FontWeight="Bold"/>

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="18,0,0,0">
                <TextBlock  Text="{Binding EntityNumber}" Foreground="{DynamicResource EntityNumberForeground}"/>
                <TextBlock Text="{Binding EntityNumberShort}"  Margin="26,0,0,0" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" FontWeight="Bold"/>
            </Canvas>
            <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas -->
            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="18,0,0,0">
                <TextBlock Text="개체" Foreground="lime" Margin="2,0,0,0"/>
                <TextBlock Text="{Binding SipNumber}" Margin="30,0,0,0" Foreground="Silver" Background="Black" FontWeight="Bold"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->

            <Canvas Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="13,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Location}"  Foreground="magenta"  Margin="2,0,0,0"/>
                <TextBlock Text="{Binding OwnerName}" Margin="32,0,0,0" Foreground="Cyan"/>
            </Canvas>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="최저가" Style="{StaticResource BasicStyle}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}}" Style="{StaticResource BasicStyle}" Foreground="Orange" FontWeight="Bold"/>

            <TextBlock Grid.Row="2" Grid.Column="1" Text="낙찰자" Foreground="Violet" Style="{StaticResource BasicStyle}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Bidder}" Style="{StaticResource BasicStyle}" Foreground="Silver" FontWeight="Bold" x:Name="bidder"/> 

            <TextBlock Grid.Row="2" Grid.Column="2" Text="낙찰가" Style="{StaticResource BasicStyle}"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding BidPrice, Converter={StaticResource NumberFormatConverter}}" Style="{StaticResource BasicStyle}" Foreground="Yellow" FontWeight="Bold"/>

        </Grid>
    </Border>
</UserControl>
