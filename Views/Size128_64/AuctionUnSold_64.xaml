<UserControl x:Class="CowAuctionSmall.Views.Size128_64.AuctionUnSold_64"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_64"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             mc:Ignorable="d" 
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased"
             d:DesignHeight="64" d:DesignWidth="128">

    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        
        <!-- 목차 스타일 -->
        <Style x:Key="BasicStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="lime"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <models:CowTypeToStyleConverter_128_64 x:Key="CowTypeToStyleConverter"/>
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
    </UserControl.Resources>

    <Grid Background="Black">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="29"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Canvas  Grid.Row="0" Grid.Column="2">
            <TextBlock Text="{Binding Sex}" Style="{Binding CopyGValues, Converter={StaticResource CowTypeToStyleConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="Sex"/>
        </Canvas>

        <!-- ======================================================================================================================================================================= -->
        <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
        <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <TextBlock Text="{Binding StrCowDistinction}"   Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction" FontSize="11"/>
            <!-- <TextBlock Text="개체 : " Foreground="lime" Margin="0,0,0,0"/> -->
            <TextBlock Text="{Binding EntityNumber}" Margin="37,0,0,0" Foreground="{DynamicResource EntityNumberForeground}" TextAlignment="Left"/>
            <TextBlock Text="{Binding EntityNumberShort}" Margin="63,0,0,0" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" FontWeight="Bold"/>
        </Canvas>
        <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas -->
        <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <TextBlock Text="개체 : " Foreground="lime" Margin="0,0,0,0"/>
            <TextBlock Text="{Binding SipNumber}" Margin="40,0,0,0" Foreground="Silver" Background="Black" FontWeight="Bold"/>
        </Canvas>
        <!-- ======================================================================================================================================================================= -->


        <Canvas Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0">
            <TextBlock Text="최저가: " Style="{StaticResource BasicStyle}"/>
            <TextBlock Text="{Binding LowestPrice}" Margin="42,0,0,0" Style="{StaticResource BasicStyle}" Foreground="Orange" FontWeight="Bold"/>
        </Canvas>

        <Canvas Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
            <!-- 생년월일 -->
            <TextBlock Text="{Binding Birth}" Foreground="Cyan" Margin="2,0,0,0" Style="{StaticResource BasicStyle}"/>
        </Canvas>

        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
            Text="유  찰" Foreground="Red" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontWeight="Bold"/>
    </Grid>
</UserControl>
