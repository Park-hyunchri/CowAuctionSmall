<UserControl x:Class="CowAuctionSmall.Views.Size128_64.AuctionUnSold_64"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_64"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             mc:Ignorable="d" 
             FontFamily="굴림"
             d:DesignHeight="64" d:DesignWidth="128">

    <UserControl.Resources>

        <!-- 목차 스타일 -->
        <Style x:Key="BasicStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="lime"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <models:CowTypeToStyleConverter x:Key="CowTypeToStyleConverter"/>
    </UserControl.Resources>

    <Grid Background="Black">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Canvas  Grid.Row="0" Grid.Column="0" Grid.RowSpan="2">
            <TextBlock Text="{Binding Sex}" Style="{Binding Sex, Converter={StaticResource CowTypeToStyleConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15,0,0,0" FontSize="25" x:Name="Sex"/>
        </Canvas>

        <Canvas Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="10,0,0,0">
            <TextBlock  Text="{Binding EntityNumber}" Foreground="Silver" />
            <TextBlock Text="{Binding EntityNumberShort}"  Margin="32,0,0,0" Foreground="red" Background="Black" FontWeight="Bold"/>
        </Canvas>

        <Canvas Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,0,0">
            <TextBlock Text="최저가: " Style="{StaticResource BasicStyle}"/>
            <TextBlock Text="{Binding LowestPrice}" Margin="42,0,0,0" Style="{StaticResource BasicStyle}" Foreground="Orange" FontWeight="Bold"/>
        </Canvas>

        <Canvas Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
            <!-- 생년월일 -->
            <TextBlock Text="{Binding Birth}" Foreground="Cyan" Margin="2,0,0,0" Style="{StaticResource BasicStyle}"/>
        </Canvas>

        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
            Text="유  찰" Foreground="Red" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontWeight="Bold"/>
    </Grid>
</UserControl>
