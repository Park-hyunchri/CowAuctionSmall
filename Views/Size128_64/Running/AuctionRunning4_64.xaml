<UserControl x:Class="CowAuctionSmall.Views.Size128_64.Running.AuctionRunning4_64"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_64.Running"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased"
             FontFamily="굴림"
             mc:Ignorable="d" 
             d:DesignHeight="64" d:DesignWidth="128">

    <UserControl.Resources>
        
        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- 목차 스타일 -->
        <Style x:Key="IndexStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Lime"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 유전능력 Num 스타일 -->
        <Style x:Key="EpdNumStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Orange"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 유전능력 Num 스타일 -->
        <Style x:Key="EpdStringStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="Silver"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:PregnancyValueConverter  x:Key="PregnancyValueConverter" />
    </UserControl.Resources>

    <Border BorderBrush="Black" BorderThickness="2">
        <Grid Background="Black" CacheMode="BitmapCache">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="5" />
                <ColumnDefinition />
                <ColumnDefinition  Width="22"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>

            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="체  장" Style="{StaticResource IndexStyle}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text=":"  Style="{StaticResource IndexStyle}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CowInfo.BodyLength}"  Style="{StaticResource EpdStringStyle}"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="cm"  Style="{StaticResource IndexStyle}"/>


            <TextBlock Grid.Row="1" Grid.Column="0" Text="체  고" Style="{StaticResource IndexStyle}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text=":"  Style="{StaticResource IndexStyle}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CowInfo.BodyHeight}" Style="{StaticResource EpdStringStyle}"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="cm"  Style="{StaticResource IndexStyle}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="십자부고" Style="{StaticResource IndexStyle}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text=":"  Style="{StaticResource IndexStyle}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CowInfo.CrossSectionalArea}" Style="{StaticResource EpdStringStyle}"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Text="cm"  Style="{StaticResource IndexStyle}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="체  폭" Style="{StaticResource IndexStyle}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text=":"  Style="{StaticResource IndexStyle}"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CowInfo.BodyWidth}" Style="{StaticResource EpdStringStyle}"/>
            <TextBlock Grid.Row="3" Grid.Column="3" Text="cm"  Style="{StaticResource IndexStyle}"/>

        </Grid>
    </Border>
</UserControl>

