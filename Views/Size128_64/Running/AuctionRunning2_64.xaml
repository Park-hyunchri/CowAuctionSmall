<UserControl x:Class="CowAuctionSmall.Views.Size128_64.Running.AuctionRunning2_64"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_64.Running"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             TextOptions.TextFormattingMode="Display"
             FontFamily="굴림"
             mc:Ignorable="d" 
             d:DesignHeight="64" d:DesignWidth="128">

    <UserControl.Resources>


        <!-- 목차 스타일 -->
        <Style x:Key="IndexStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="lime"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <Style x:Key="DataStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <models:CowTypeToStyleConverter x:Key="CowTypeToStyleConverter"/>
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:PregnancyValueConverter  x:Key="PregnancyValueConverter" />
    </UserControl.Resources>

    <Border x:Name="border" BorderThickness="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid>
            <Canvas Margin="97,0,0,38">
                <TextBlock Text="{Binding CowInfo.Sex}" Style="{Binding CowInfo.Sex, Converter={StaticResource CowTypeToStyleConverter}}" VerticalAlignment="Top" x:Name="Sex" Margin="3,-4,0,0" FontSize="24"/>
            </Canvas>

            <Canvas Margin="0,0,0,0">
                <TextBlock Text="개체 :"  Style="{StaticResource IndexStyle}"/>
                <TextBlock Text="{Binding CowInfo.EntityNumber}" Margin="35,0,0,0" Foreground="Silver" Style="{StaticResource DataStyle}" x:Name="EntityNumber"/>
                <TextBlock Text="{Binding CowInfo.EntityNumberShort}" Margin="61,0,0,0" Foreground="red" Background="Black" Style="{StaticResource DataStyle}" FontWeight="Bold"/>
            </Canvas>

            <Canvas Margin="0,12,0,0">
                <TextBlock Text="KPN :" Style="{StaticResource IndexStyle}"/>
                <TextBlock Text="{Binding CowInfo.KPN}" Margin="42,0,0,0" Foreground="Orange" Style="{StaticResource DataStyle}"/>
            </Canvas>

            <Canvas Margin="0,24,0,0">
                <TextBlock Text="산차 :"  Style="{StaticResource IndexStyle}"/>
                <TextBlock Text="{Binding CowInfo.CalvingNumber}" Margin="42,0,0,0" Foreground="Orange" Style="{StaticResource DataStyle}"/>
            </Canvas>

            <Canvas Margin="65,24,0,0">
                <TextBlock Text="계대:"  Style="{StaticResource IndexStyle}"/>
                <TextBlock Text="{Binding CowInfo.Blood}" Margin="37,0,0,0" Foreground="Orange" Style="{StaticResource DataStyle}"/>
            </Canvas>

            <Canvas Margin="0,36,0,0">
                <TextBlock Text="어미 :" Style="{StaticResource IndexStyle}"/>
                <TextBlock Text="{Binding CowInfo.MotherLevel, Converter={StaticResource MotherLevelConverter}}" Margin="42,0,0,0" Foreground="Orange" Style="{StaticResource DataStyle}"/>
            </Canvas>

            <Canvas Margin="65,36,0,0" >
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CowInfo.Pregnant, Converter={StaticResource PregnancyValueConverter}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>
                <TextBlock Text="임신:"  Style="{StaticResource IndexStyle}"/>
                <TextBlock Text="{Binding CowInfo.Pregnant}" Margin="35,0,0,0" Foreground="Yellow" Style="{StaticResource DataStyle}"/>
            </Canvas>

            <!-- Note를 표시하는 TextBlock -->
            <Canvas x:Name="canvas" ClipToBounds="True" Margin="0,48,0,0">
                <TextBlock x:Name="note" Text="{Binding CowInfo.Note}" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="Red" FontWeight="Regular"/>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
