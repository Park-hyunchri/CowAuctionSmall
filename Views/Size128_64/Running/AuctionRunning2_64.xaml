<UserControl x:Class="CowAuctionSmall.Views.Size128_64.Running.AuctionRunning2_64"
             xmlns:entity="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:noteStyle="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_64.Running"
             xmlns:models="clr-namespace:CowAuctionSmall.Presentation.Converters"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased"
             FontFamily="굴림"
             mc:Ignorable="d" 
             d:DesignHeight="64" d:DesignWidth="128">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- 목차 스타일 -->
        <Style x:Key="IndexStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="lime"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <Style x:Key="DataStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 추가 -->
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:ShowMatherBloodConverter x:Key="ShowMatherBloodConverter" />
        <models:SelectShowWeight_EPDString x:Key="SelectShowWeight_EPDString" />
        <models:BorderOutlineConverter x:Key="BorderOutlineConverter"/>
        <models:BloodFontStyle x:Key="BloodFontStyle"/>
    </UserControl.Resources>

    <Border x:Name="border" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid DataContext="{Binding CowInfo}" CacheMode="BitmapCache">
            <Canvas Margin="97,0,0,38">
                <TextBlock Style="{StaticResource SexText128x64}" DataContext="{Binding DataContext.ItemDisplay, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning2_64}}}" VerticalAlignment="Top" x:Name="Sex"/>
            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="{Binding StrCowDistinction}"   Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction" FontSize="11"/>
                <!-- <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0"/> -->
                <entity:EntityNumberText Number="{Binding EntityNumber}" Margin="35,0,0,0" Foreground="{DynamicResource EntityNumberForeground}" HighlightForeground="{DynamicResource EntityNumberShortForeground}" Style="{StaticResource {x:Type TextBlock}}" />
            </Canvas>
            <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas -->
            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
                <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0"/>
                <entity:EntityNumberText Number="{Binding EntityNumber}" Margin="40,0,0,0" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" FontWeight="Bold" DisplayMode="Short" CowDistinction="{Binding CowDistinction}" Style="{StaticResource {x:Type TextBlock}}" />
            </Canvas>
            <!-- ======================================================================================================================================================================= -->

            <Canvas Margin="0,13,0,0">
                <TextBlock Text="KPN" Style="{StaticResource IndexStyle}" FontSize="11"/>
                <TextBlock Text=":" Style="{StaticResource IndexStyle}" Margin="27,0,0,0"/>
                <TextBlock Text="{Binding KPN}" Margin="35,0,0,0" Foreground="Orange" Style="{StaticResource DataStyle}"/>
            </Canvas>

            <Canvas Margin="0,25,0,0">
                <TextBlock Text="산차"  Style="{StaticResource IndexStyle}" FontSize="11"/>
                <TextBlock Text=":" Style="{StaticResource IndexStyle}" Margin="27,0,0,0"/>
                <TextBlock Text="{Binding CalvingNumber}" Margin="42,0,0,0" Foreground="Orange" Style="{StaticResource DataStyle}"/>
            </Canvas>

            <Canvas Margin="75,25,0,0">
                <TextBlock Text="계대"  Style="{StaticResource IndexStyle}" FontSize="11"/>
                <TextBlock Text=":" Style="{StaticResource IndexStyle}" Margin="23,0,0,0"/>
                <TextBlock Text="{Binding Blood}" Margin="37,0,0,0" Foreground="Orange" Style="{StaticResource DataStyle}"/>
            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <Canvas Margin="0,37,0,0">
                <TextBlock Text="등록"  Foreground="lime" Margin="2,0,0,0" FontSize="11"/>
                <TextBlock Text=":" Style="{StaticResource IndexStyle}" Margin="27,0,0,0"/>
                <TextBlock Text="{Binding RegistrationCategory, Converter={StaticResource MotherLevelConverter}}" Style="{Binding RegistrationCategory, Converter={StaticResource BloodFontStyle}}" Margin="32,0,0,0" Foreground="Orange"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->

            <Canvas Margin="75,37,0,0" >
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ItemDisplay.ShowPregnancy, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning2_64}}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>
                <TextBlock Text="임신:"  Style="{StaticResource IndexStyle}" FontSize="11"/>
                <TextBlock Text="{Binding Pregnant}" Margin="35,0,0,0" Foreground="Yellow" Style="{StaticResource DataStyle}"/>
            </Canvas>

            <!-- Note를 표시하는 TextBlock -->
            <Canvas x:Name="canvas" ClipToBounds="True" Margin="0,52,0,0">
                <TextBlock x:Name="note" noteStyle:NoteText.Normal="{Binding DataContext.Note, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning2_64}}}" noteStyle:NoteText.History="{Binding DataContext.NoteChangeOwner, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning2_64}}}" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Red" FontWeight="Regular" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" RenderTransformOrigin="0,0"/>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
