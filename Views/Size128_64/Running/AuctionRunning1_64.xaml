<UserControl x:Class="CowAuctionSmall.Views.Size128_64.Running.AuctionRunning1_64"
             xmlns:entity="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:noteStyle="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_64.Running"
             xmlns:models="clr-namespace:CowAuctionSmall.Presentation.Converters"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased"
             mc:Ignorable="d" 
             d:DesignHeight="64" d:DesignWidth="128">


    <UserControl.Resources>
        <Style x:Key="BlinkingBorderStyle2" TargetType="Border">
            <Setter Property="BorderBrush" Value="black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning1_64}}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames
                                    Storyboard.TargetProperty="(Border.BorderBrush)"
                                    Duration="0:0:1">
                                    <!-- 검정색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="Black"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>

                                    <!-- 빨간색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="#FD3A4A"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- 목차 스타일 -->
        <Style x:Key="IndexStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="lime"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <Style x:Key="DataStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            
        </Style>

        <!-- 추가 -->
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:ShowMatherBloodConverter x:Key="ShowMatherBloodConverter" />
        <models:SelectShowWeight_EPDString x:Key="SelectShowWeight_EPDString" />
        <models:BorderOutlineConverter x:Key="BorderOutlineConverter"/>
    </UserControl.Resources>

    <Border x:Name="border" Style="{StaticResource BlinkingBorderStyle2}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid DataContext="{Binding CowInfo}" CacheMode="BitmapCache">
            <Canvas Margin="97,0,0,38">
                <TextBlock Style="{StaticResource SexText128x64}" DataContext="{Binding DataContext.ItemDisplay, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning1_64}}}" VerticalAlignment="Top" x:Name="Sex"/>
            </Canvas>
            

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="{Binding StrCowDistinction}"   Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction" FontSize="11"/>
                <!-- <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0"/> -->
                <entity:EntityNumberText Number="{Binding EntityNumber}" Margin="35,0,0,0" Foreground="{DynamicResource EntityNumberForeground}" HighlightForeground="{DynamicResource EntityNumberShortForeground}" Style="{StaticResource {x:Type TextBlock}}" />
            </Canvas>
            <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas -->
            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
                <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0"/>
                <TextBlock Text="{Binding SipNumber}" Margin="40,0,0,0" Foreground="Silver" Background="Black"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->

            <Canvas Margin="0,12,0,0">
                <TextBlock Text="{Binding Location}"  Foreground="magenta"  Margin="2,1,0,0" FontSize="11"/>
                <TextBlock Text="{Binding OwnerName}" Margin="32,0,0,0" Foreground="Cyan" FontSize="11"/>
            </Canvas>

            <Canvas Margin="0,23,0,0">
                <TextBlock Text="{Binding Birth}" Foreground="Cyan" Margin="2,0,0,0" FontSize="11"/>
            </Canvas>

            <Canvas Margin="0,36,0,0">
                <TextBlock Text="최저:"  Style="{StaticResource IndexStyle}" FontSize="12" Margin="0,1,0,0"/>
                <TextBlock Text="{Binding DataContext.ItemDisplay.LowestPriceText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning1_64}}}" Margin="30,0,0,0" Foreground="Yellow" Style="{StaticResource DataStyle}" FontSize="14"/>
            </Canvas>

            <Canvas Margin="75,36,0,0">
                <TextBlock Text="중량"  Style="{StaticResource IndexStyle}"/>
                <TextBlock Text="{Binding DataContext.ItemDisplay.FormattedWeightText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning1_64}}}" Margin="25,0,0,0" Foreground="Yellow" Style="{StaticResource DataStyle}"/>
            </Canvas>

            

            <!-- Note를 표시하는 TextBlock -->
            <Canvas x:Name="canvas" ClipToBounds="True" Margin="0,52,0,0">
                <TextBlock x:Name="note" noteStyle:NoteText.Normal="{Binding DataContext.Note, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning1_64}}}" noteStyle:NoteText.History="{Binding DataContext.NoteChangeOwner, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning1_64}}}" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Red" FontWeight="Regular" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" RenderTransformOrigin="0,0"/>
            </Canvas>

        </Grid>
    </Border>

</UserControl>
