<UserControl x:Class="CowAuctionSmall.Views.Size_320_64.Running.AuctionRunning1_320_64"
             xmlns:entity="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:noteStyle="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size_320_64.Running"
             xmlns:models="clr-namespace:CowAuctionSmall.Presentation.Converters"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased"
             TextOptions.TextHintingMode="Fixed"
             mc:Ignorable="d" 
             d:DesignHeight="64" d:DesignWidth="320">


    <UserControl.Resources>
        <Style x:Key="BlinkingBorderStyle2" TargetType="Border">
            <Setter Property="BorderBrush" Value="black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning1_320_64}}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames
                                    Storyboard.TargetProperty="(Border.BorderBrush)"
                                    Duration="0:0:1">
                                    <!-- 검정색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="Black"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>

                                    <!-- 빨간색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="#FD3A4A"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 목차 스타일 -->
        <Style x:Key="IndexStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="lime"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <Style x:Key="DataStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 유전능력 Num 스타일 -->
        <Style x:Key="EpdNumStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Orange"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 유전능력 Num 스타일 -->
        <Style x:Key="EpdStringStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Silver"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 추가 -->
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:ShowMatherBloodConverter x:Key="ShowMatherBloodConverter" />
        <models:SelectShowWeight_EPDString x:Key="SelectShowWeight_EPDString" />
        <models:BorderOutlineConverter x:Key="BorderOutlineConverter"/>
        <models:BloodFontStyle x:Key="BloodFontStyle"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding CowInfo}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="4"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="border" Style="{StaticResource BlinkingBorderStyle2}" BorderThickness="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black" Grid.Column="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Canvas Margin="135,0,0,38">
                    <TextBlock Style="{StaticResource SexText160x64}" DataContext="{Binding DataContext.ItemDisplay, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning1_320_64}}}" VerticalAlignment="Top" x:Name="Sex"/>
                </Canvas>


                <!-- ======================================================================================================================================================================= -->
                <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
                <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                    <TextBlock Text="{Binding StrCowDistinction}"   Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction" FontSize="11"/>
                    <!-- <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0"/> -->
                    <entity:EntityNumberText Number="{Binding EntityNumber}" Margin="38,0,0,0" Foreground="{DynamicResource EntityNumberForeground}" HighlightForeground="{DynamicResource EntityNumberShortForeground}" HighlightFontWeight="Bold" />
                    <TextBlock Text="{Binding OwnerName}" Margin="103,0,0,0" Foreground="Cyan"/>
                </Canvas>
                <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas -->
                <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
                    <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0"/>
                    <entity:EntityNumberText Number="{Binding EntityNumber}" Margin="40,0,0,0" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" DisplayMode="Short" CowDistinction="{Binding CowDistinction}" />
                </Canvas>
                <!-- ======================================================================================================================================================================= -->



                <Canvas Margin="0,16,0,0">
                    <TextBlock Text="{Binding RegistrationCategory, Converter={StaticResource MotherLevelConverter}}" Style="{Binding RegistrationCategory, Converter={StaticResource BloodFontStyle}}"  Margin="2,0,0,0" />
                    <TextBlock Text="{Binding Birth}" Foreground="Cyan" Margin="30,0,0,0"/>
                </Canvas>

                <Canvas Margin="0,31,0,0">
                    <TextBlock Text="최저 :"  Style="{StaticResource IndexStyle}"/>
                    <TextBlock Text="{Binding DataContext.ItemDisplay.LowestPriceText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning1_320_64}}}" Margin="35,0,0,0" Foreground="Yellow" Style="{StaticResource DataStyle}"/>
                </Canvas>

                <Canvas Margin="65,31,0,0">
                    <TextBlock Text="중량:"  Style="{StaticResource IndexStyle}"/>
                    <TextBlock Text="{Binding DataContext.ItemDisplay.FormattedWeightText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning1_320_64}}}" Margin="32,0,0,0" Foreground="Yellow" Style="{StaticResource DataStyle}"/>
                </Canvas>

                <Canvas Margin="120,31,0,0" >
                    <Canvas.Style>
                        <Style TargetType="Canvas">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.ItemDisplay.ShowPregnancy, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning1_320_64}}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Canvas.Style>
                    <TextBlock Text="임신:"  Foreground="lime" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding Pregnant}" Margin="36,0,0,0" Foreground="Yellow"/>
                </Canvas>

                <Canvas Margin="0,47,0,0">
                    <TextBlock Text="{Binding KPN, StringFormat='K{0}'}"  Foreground="Beige" FontWeight="Bold" Margin="2,0,0,0"/>
                </Canvas>

                <!-- Note를 표시하는 TextBlock -->
                <Canvas x:Name="canvas" ClipToBounds="True" Margin="45,47,0,0" Width="145">
                    <TextBlock x:Name="note" noteStyle:NoteText.Normal="{Binding DataContext.Note, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning1_320_64}}}" noteStyle:NoteText.History="{Binding DataContext.NoteChangeOwner, RelativeSource={RelativeSource AncestorType={x:Type local:AuctionRunning1_320_64}}}" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Red" FontWeight="Regular" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" RenderTransformOrigin="0,0"/>
                </Canvas>

                <Border BorderBrush="Black" BorderThickness="2" Grid.Column="1">
                    <Grid Background="Black">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>

                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="냉도체중" Style="{StaticResource IndexStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text=":" Style="{StaticResource IndexStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding bodyWeightInColdNum}"  Style="{StaticResource EpdNumStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding bodyWeightInColdString}"  Style="{StaticResource EpdStringStyle}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="배최장근" Style="{StaticResource IndexStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text=":" Style="{StaticResource IndexStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding longestMuscleCrossSectionNum}"  Style="{StaticResource EpdNumStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding longestMuscleCrossSectionString}" Style="{StaticResource EpdStringStyle}"/>


                        <TextBlock Grid.Row="2" Grid.Column="0" Text="등 지 방" Style="{StaticResource IndexStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text=":" Style="{StaticResource IndexStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding fatThicknessOnBackNum}" Style="{StaticResource EpdNumStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding fatThicknessOnBackString}" Style="{StaticResource EpdStringStyle}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="근내지방" Style="{StaticResource IndexStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text=":" Style="{StaticResource IndexStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding intramuscularFatContentNum}"  Style="{StaticResource EpdNumStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding intramuscularFatContentString}" Style="{StaticResource EpdStringStyle}"/>


                    </Grid>
                </Border>

            </Grid>
        </Border>

        

        <Border Grid.Column="1" Background="Silver"/>
    </Grid>

</UserControl>