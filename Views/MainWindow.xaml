<Window x:Class="CowAuctionSmall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding MainWindowWidth}" Height="{Binding MainWindowHeight, Mode=TwoWay}" Width="{Binding MainWindowWidth , Mode=TwoWay}" WindowStartupLocation="Manual" Top="{Binding MainPositionX ,Mode=TwoWay}" WindowStyle="None" Left="{Binding MainPositionY , Mode=TwoWay}" ResizeMode="NoResize" KeyDown="Window_KeyDown" Background="Black" >
    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Background="Black" >
        <Grid Background="Black">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        
        
                <!-- Content를 표시할 ContentPresenter 추가 -->
            <ContentPresenter Content="{Binding MainContainer}" Grid.Row="0"/>


            <Grid Grid.Row="1" x:Name="MainStatusFooter" SizeChanged="MainStatusFooter_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>
                <Border Background="#111111" Margin="0,1,0,0">
                    <WrapPanel>
                        <WrapPanel.Resources>
                            <Style x:Key="StatusCell" TargetType="Border">
                                <Setter Property="BorderBrush" Value="#404040"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                <Setter Property="Padding" Value="12,5"/>
                                <Setter Property="MinHeight" Value="28"/>
                                <Setter Property="MaxWidth" Value="{Binding ActualWidth, ElementName=MainStatusFooter}"/>
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#DADADA"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </WrapPanel.Resources>
                        <Border Style="{StaticResource StatusCell}" ToolTip="{Binding StatusBar.ServerText}">
                            <DockPanel LastChildFill="True">
                                <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="5,0,0,0" Fill="{Binding StatusBar.ServerBrush}"/>
                                <TextBlock Text="{Binding StatusBar.ServerText}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource StatusCell}">
                            <TextBlock Text="{Binding StatusBar.RoleText}"/>
                        </Border>
                        <Border Style="{StaticResource StatusCell}">
                            <TextBlock Text="{Binding StatusBar.AuctionText}"/>
                        </Border>
                        <Border Style="{StaticResource StatusCell}">
                            <TextBlock Text="{Binding StatusBar.RootFarmText}"/>
                        </Border>
                        <Border Style="{StaticResource StatusCell}" ToolTip="{Binding StatusBar.RotationDetail}">
                            <WrapPanel>
                                <TextBlock Text="{Binding StatusBar.PageText}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding StatusBar.RotationText}"/>
                                <ItemsControl ItemsSource="{Binding StatusBar.PageDots}" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><Ellipse Width="8" Height="8" Fill="{Binding}" Margin="3,0,0,0"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </Border>
                        <Border ToolTip="{Binding AuctionSectionText}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StatusCell}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AuctionSectionText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding AuctionSectionText}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding AuctionSectionText}"/>
                        </Border>
                        <Border Style="{StaticResource StatusCell}">
                            <TextBlock Text="{Binding StatusBar.VersionText}"/>
                        </Border>
                    </WrapPanel>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding AuctionSignalText}" Foreground="#DADADA" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding AuctionSignalDisplayText}"/>
                <TextBlock Grid.Row="2" Text="{Binding HistoryProgressText, Mode=OneWay}" Foreground="#DADADA" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding HistoryProgressText}"/>
                <TextBox Grid.Row="3" x:Name="MsgTextBox" Background="Black" Text="{Binding MainWindowTextBox, UpdateSourceTrigger=PropertyChanged}" Foreground="Lime" IsReadOnly="True" Margin="0,1,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"
                         BorderThickness="0" BorderBrush="Transparent" TextChanged="MsgTextBox_TextChanged">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="표시 중인 소유주 이력 새로고침" ToolTip="당일 호출 예산 안에서 조회합니다. 최근 조회 후 1분 동안은 저장된 결과를 사용합니다."
                                      Command="{Binding PlacementTarget.DataContext.RefreshOwnerHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
            </Grid>

        </Grid>
    </ScrollViewer>
</Window>
