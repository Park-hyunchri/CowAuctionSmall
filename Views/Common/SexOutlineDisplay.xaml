<UserControl x:Class="CowAuctionSmall.Views.Common.SexOutlineDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns:vm="clr-namespace:CowAuctionSmall.ViewModels"
             x:Name="Root" UseLayoutRounding="False">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="FontFamily" Value="굴림"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="#FF69B4"/>
            <Setter Property="Margin" Value="74,-3,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SexStyleKey}" Value="암">
                    <Setter Property="Foreground" Value="#FF0050"/>
                    <Setter Property="Margin" Value="90,-3,0,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SexStyleKey}" Value="수">
                    <Setter Property="Foreground" Value="#5CAFFF"/>
                    <Setter Property="Margin" Value="90,-3,0,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SexStyleKey}" Value="거세"><Setter Property="Foreground" Value="#D6B700"/></DataTrigger>
                <DataTrigger Binding="{Binding SexStyleKey}" Value="비육"><Setter Property="Foreground" Value="#FED900"/></DataTrigger>
                <DataTrigger Binding="{Binding SexStyleKey}" Value="암소"><Setter Property="Foreground" Value="#D60053"/></DataTrigger>
                <DataTrigger Binding="{Binding SexStyleKey}" Value="숫소"><Setter Property="Foreground" Value="#5CAFFF"/></DataTrigger>
                <DataTrigger Binding="{Binding SexStyleKey}" Value="프리마틴"><Setter Property="Foreground" Value="#5CAFFF"/></DataTrigger>
                <DataTrigger Binding="{Binding SexStyleKey}" Value="비거세"><Setter Property="Foreground" Value="#D6B700"/></DataTrigger>
                <DataTrigger Binding="{Binding SexStyleKey}" Value="공통"><Setter Property="Foreground" Value="#5CAFFF"/></DataTrigger>
                <DataTrigger Binding="{Binding SexStyleKey}" Value="일치"><Setter Property="FontSize" Value="14"/></DataTrigger>
                <DataTrigger Binding="{Binding SexPresentationMode}" Value="{x:Static vm:SexPresentationMode.Matched}">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Regular"/>
                    <Setter Property="Foreground" Value="#FF69B4"/>
                    <Setter Property="Margin" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
        <Border x:Name="Frame" Background="Transparent" BorderBrush="{Binding Foreground, ElementName=Root}"
                Height="{Binding FontSize, ElementName=Root}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="48"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SexStyleKey}" Value="일치"><Setter Property="Width" Value="28"/></DataTrigger>
                        <DataTrigger Binding="{Binding SexPresentationMode}" Value="{x:Static vm:SexPresentationMode.Plain}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding SexPresentationMode}" Value="{x:Static vm:SexPresentationMode.Matched}">
                            <Setter Property="Width" Value="28"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="3"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSingleCharacterOutlinedSex}" Value="True">
                            <Setter Property="Width" Value="{Binding FontSize, ElementName=Root}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <local:OutlinedTextBlock x:Name="OutlinedText" Text="{Binding OutlinedSexText, Mode=OneWay}"
                                 Fill="{Binding Foreground, ElementName=Root}" Stroke="{Binding Foreground, ElementName=Root}"
                                 FontFamily="{Binding FontFamily, ElementName=Root}" FontSize="{Binding FontSize, ElementName=Root}"
                                 FontWeight="{Binding FontWeight, ElementName=Root}">
            <local:OutlinedTextBlock.Style>
                <Style TargetType="local:OutlinedTextBlock">
                    <Setter Property="StrokeThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsThreeCharacterOutlinedSex}" Value="True">
                            <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.6" ScaleY="1"/></Setter.Value></Setter>
                            <Setter Property="Margin" Value="2,0,0,0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SexPresentationMode}" Value="{x:Static vm:SexPresentationMode.Plain}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding SexPresentationMode}" Value="{x:Static vm:SexPresentationMode.Matched}"><Setter Property="StrokeThickness" Value="0.2"/></DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsThreeCharacterOutlinedSex}" Value="True"/>
                                <Condition Binding="{Binding SexPresentationMode}" Value="{x:Static vm:SexPresentationMode.Matched}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Margin" Value="1,0,0,0"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </local:OutlinedTextBlock.Style>
        </local:OutlinedTextBlock>
        <TextBlock x:Name="PlainText" Text="{Binding OutlinedSexText, Mode=OneWay}"
                   Foreground="{Binding Foreground, ElementName=Root}" FontFamily="{Binding FontFamily, ElementName=Root}"
                   FontSize="{Binding FontSize, ElementName=Root}" FontWeight="{Binding FontWeight, ElementName=Root}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SexPresentationMode}" Value="{x:Static vm:SexPresentationMode.Plain}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsThreeCharacterOutlinedSex}" Value="True">
                            <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.6666666666666666" ScaleY="1"/></Setter.Value></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
