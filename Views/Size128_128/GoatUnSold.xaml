<UserControl x:Class="CowAuctionSmall.Views.Size128_128.GoatUnSold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">

    <UserControl.Resources>

        <!-- 추가 -->
        <models:CowTypeToStyleConverter_V2 x:Key="CowTypeToStyleConverter_V2"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:WeightKGConverter x:Key="WeightKGConverter"/>

        <models:SelectShowWeightEpdMultiConverter x:Key="SelectShowWeightEpdMultiConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

    </UserControl.Resources>


    <Border BorderThickness="3" BorderBrush="OrangeRed"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid>

            <TextBlock Margin="0,0,0,0" Text="유   찰" HorizontalAlignment="Center" Foreground="OrangeRed" FontSize="23" FontWeight="Bold"/>

            <Canvas Margin="0,28,0,0">
                <TextBlock Text="{Binding Sex}" Style="{Binding CopyGValues, Converter={StaticResource CowTypeToStyleConverter_V2}}" x:Name="Sex" Panel.ZIndex="110"/>
            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas  5:염소 6:말-->
            <!-- ======================================================================================================================================================================= -->
            <TextBlock Text="지역"  Foreground="lime"  Margin="2,36,0,0"/>
            <TextBlock Text="{Binding Location}"  Foreground="lime"  Margin="30,36,0,0"/>

            <TextBlock Text="출하주"  Foreground="lime"  Margin="2,53,0,0"/>
            <TextBlock Text=":"  Foreground="lime"  Margin="40,53,0,0"/>
            <TextBlock Text="{Binding OwnerName}" Margin="47,53,0,0" Foreground="Cyan"/>

            <TextBlock Text="최저"  Foreground="lime"  Margin="2,67,0,0" FontSize="17"/>
            <TextBlock Text=":"  Foreground="lime"  Margin="40,67,0,0" FontSize="17"/>
            <TextBlock Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}}" Margin="50,67,0,0" Foreground="Yellow" FontSize="17"/>

            <!-- ======================================================================================================================================================================= -->
            <TextBlock Text="중량" Foreground="lime" Margin="2,85,0,0" FontSize="17"/>
            <TextBlock Text=":"  Foreground="lime"  Margin="40,85,0,0" FontSize="17"/>
            <TextBlock Text="{Binding Weight, Converter={StaticResource WeightKGConverter}}" Margin="50,85,0,0" Foreground="Yellow" FontSize="17"/>

            <!-- Note를 표시하는 TextBlock -->
            <Canvas Grid.Row="5" x:Name="canvas" ClipToBounds="True" Panel.ZIndex="100" Margin="0,105,0,0">
                <TextBlock x:Name="note" Text="{Binding Note}" HorizontalAlignment="Left" Foreground="#f61c2d" FontWeight="Regular" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" RenderTransformOrigin="0,0"/>
            </Canvas>
        </Grid>
    </Border>


</UserControl>

