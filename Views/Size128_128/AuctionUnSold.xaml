<UserControl x:Class="CowAuctionSmall.Views.Size128_128.AuctionUnSold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">


    <UserControl.Resources>
        <models:CowTypeToStyleConverter x:Key="CowTypeToStyleConverter"/>
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="black">

        <!-- "유찰"을 표시하는 TextBlock -->
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Text="유    찰" FontSize="25" Foreground="red" FontWeight="Bold"/>

        <Canvas Margin="0,30,0,0">
            <TextBlock Text="{Binding Sex}" Style="{Binding Sex, Converter={StaticResource CowTypeToStyleConverter}}" VerticalAlignment="Top" Margin="80,0,0,0" x:Name="Sex"/>
        </Canvas>

        <Canvas Margin="0,35,0,0">
            <TextBlock Text="최저 : "  Foreground="lime"  Margin="2,0,0,0"/>
            <TextBlock Text="{Binding LowestPrice}" Margin="40,0,0,0" Foreground="Yellow"/>
        </Canvas>

        <Canvas Margin="0,50,0,0">
            <TextBlock Text="중량 : "  Foreground="lime" Margin="2,0,0,0"/>
            <TextBlock Text="{Binding Weight}" Margin="40,0,0,0" Foreground="Yellow"/>
        </Canvas>

        <Canvas Margin="0,65,0,0">
            <!-- 생년월일 -->
            <TextBlock Text="{Binding Birth}" Foreground="Cyan" Margin="2,0,0,0"/>
        </Canvas>

        <!-- ======================================================================================================================================================================= -->
        <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
        <Canvas Margin="0,80,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
            <TextBlock Text="개체 : "  Foreground="lime" Margin="2,0,0,0" />
            <TextBlock Text="{Binding EntityNumber}" Margin="40,0,0,0" Foreground="Silver"/>
            <TextBlock Text="{Binding EntityNumberShort}" Margin="68,0,0,0" Foreground="red" Background="Black"/>
        </Canvas>
        <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas -->
        <Canvas Margin="0,80,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
            <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0" />
            <TextBlock Text="{Binding EntityNumberShort}" Margin="40,0,0,0" Foreground="Silver" Background="Black" FontWeight="Bold"/>
        </Canvas>
        <!-- ======================================================================================================================================================================= -->

        <Canvas Margin="0,95,0,0">
            <TextBlock Text="{Binding Location}"  Foreground="magenta" Margin="2,0,0,0"/>
            <TextBlock Text="{Binding OwnerName}" Margin="40,0,0,0" Foreground="Cyan"/>
        </Canvas>

        <!-- Note를 표시하는 TextBlock -->
        <Canvas x:Name="canvas" ClipToBounds="True" Margin="2,109,2,1">
            <TextBlock x:Name="note" Text="{Binding Note}" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="Red"/>
        </Canvas>

    </Grid>

</UserControl>
