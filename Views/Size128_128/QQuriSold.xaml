<UserControl x:Class="CowAuctionSmall.Views.Size128_128.QQuriSold"
             xmlns:entity="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128"
             xmlns:models="clr-namespace:CowAuctionSmall.Presentation.Converters"
             xmlns:common="clr-namespace:CowAuctionSmall.Views.Common"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">

    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border DataContext="{Binding Snapshot}" BorderBrush="#1E90FF" BorderThickness="2">

        <Grid Background="Black">

            <Grid.RowDefinitions>
                <RowDefinition Height="23"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.2*"/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" HorizontalAlignment="Center" VerticalAlignment="Top" Text="낙    찰" FontSize="22" Foreground="Violet" FontWeight="Bold"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"  Text="{Binding StrCowDistinction}"   Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction" FontSize="13" Margin="-5,0,0,0"/>
            <entity:EntityNumberText Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Number="{Binding EntityNumber}" HorizontalAlignment="Left" VerticalAlignment="Bottom"  Foreground="{DynamicResource EntityNumberForeground}" FontSize="13" HighlightForeground="{DynamicResource EntityNumberShortForeground}" HighlightFontWeight="Regular" Style="{StaticResource {x:Type TextBlock}}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="최저가 :"  Foreground="lime" FontSize="12"  VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock  Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding DataContext.LowestPriceText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:QQuriSold}}}" Foreground="Cyan" Margin="7,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <!-- 기본: 중량 안 보일 때(2,3,5 이외) => 크게 -->
                        <Setter Property="FontSize" Value="17"/>

                        <Style.Triggers>
                            <!-- CowDistinction 이 2일 때 (중량 보임) => 작게 -->
                            <DataTrigger Binding="{Binding CowDistinction}" Value="2">
                                <Setter Property="FontSize" Value="12"/>
                            </DataTrigger>

                            <!-- CowDistinction 이 3일 때 -->
                            <DataTrigger Binding="{Binding CowDistinction}" Value="3">
                                <Setter Property="FontSize" Value="12"/>
                            </DataTrigger>

                            <!-- CowDistinction 이 5일 때 -->
                            <DataTrigger Binding="{Binding CowDistinction}" Value="5">
                                <Setter Property="FontSize" Value="12"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 낙찰가 : 라벨 -->
            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="낙찰가 :"  Foreground="WhiteSmoke" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"/>

            <!-- 낙찰가 : 값 -->
            <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding DataContext.BidPriceText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:QQuriSold}}}" Foreground="WhiteSmoke" Margin="7,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <!-- 기본: 중량 안 보일 때(2,3,5 이외) => 크게 -->
                        <Setter Property="FontSize" Value="17"/>

                        <Style.Triggers>
                            <!-- CowDistinction 이 2일 때 (중량 보임) => 작게 -->
                            <DataTrigger Binding="{Binding CowDistinction}" Value="2">
                                <Setter Property="FontSize" Value="13"/>
                            </DataTrigger>

                            <!-- CowDistinction 이 3일 때 -->
                            <DataTrigger Binding="{Binding CowDistinction}" Value="3">
                                <Setter Property="FontSize" Value="13"/>
                            </DataTrigger>

                            <!-- CowDistinction 이 5일 때 -->
                            <DataTrigger Binding="{Binding CowDistinction}" Value="5">
                                <Setter Property="FontSize" Value="13"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal"  VerticalAlignment="Center" Margin="0,3,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <!-- 기본은 안 보이게 -->
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <!-- CowDistinction 이 2일 때 보이게 -->
                            <DataTrigger Binding="{Binding CowDistinction}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!-- CowDistinction 이 3일 때 보이게 -->
                            <DataTrigger Binding="{Binding CowDistinction}" Value="3">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!-- CowDistinction 이 5일 때 보이게 -->
                            <DataTrigger Binding="{Binding CowDistinction}" Value="5">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!--  중량 취급 안함 260707 jsr
                <TextBlock Text="중량2" Foreground="lime" FontSize="12" Margin="6,0,0,0"/>
                <TextBlock Text=":" Foreground="lime" FontSize="12" Margin="11,0,0,0"/>
                <TextBlock Foreground="Cyan" FontSize="12" Margin="7,0,0,0">
                    <Run Text="{Binding Weight, Converter={StaticResource NumberFormatConverter}}" Foreground="Orange"/>
                    <Run Text=" kg" Foreground="Orange"/>
                </TextBlock>
                -->
                
            </StackPanel>





            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2" Foreground="Violet" FontSize="12" VerticalAlignment="Center" Text="낙찰자"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2" Text=":" Foreground="Violet" FontSize="12" Margin="41,0,0,0" VerticalAlignment="Center"/>

            <Grid Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="3" Grid.RowSpan="2" VerticalAlignment="Center" Height="32">

                <!-- N : 숫자만 (현재와 동일한 형태) -->
                <TextBlock x:Name="tbBidderNumberOnly" Text="{Binding Bidder}" Foreground="Yellow" FontSize="30" FontWeight="Bold"  VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-10,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BidderName}" Value="N">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Y/X : 이름 또는 마스킹 이름 (표시 폭 초과 시 한 줄 흐름) -->
                <common:BidderNameFlow Text="{Binding Bidder}"
                                       FontWeight="Bold"
                                       Height="20"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"
                                       Margin="0,2,0,0">
                    <common:BidderNameFlow.Style>
                        <Style TargetType="{x:Type common:BidderNameFlow}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BidderName}" Value="Y">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BidderName}" Value="X">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </common:BidderNameFlow.Style>
                </common:BidderNameFlow>


                <!-- B : 윗줄 이름, 아랫줄 숫자 -->
                <StackPanel x:Name="spBidderNumberAndName" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BidderName}" Value="B">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- 윗줄 : 이름 (표시 폭 초과 시 한 줄 흐름) -->
                    <common:BidderNameFlow Text="{Binding BidderString}"
                                           FontSize="12"
                                           Height="14"
                                           HorizontalAlignment="Stretch"/>

                    <!-- 아랫줄 : 숫자 -->
                    <TextBlock Foreground="Yellow" FontSize="16" TextAlignment="Center" FontWeight="Regular" Margin="-15,0,0,0">
                        <Run Text="(" />
                        <Run Text="{Binding BidderNum}" />
                        <Run Text=")" />
                    </TextBlock>

                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
