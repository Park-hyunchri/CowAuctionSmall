<UserControl x:Class="CowAuctionSmall.Views.Size128_128.CustomAUctionUnSold.OutLineUnSold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.CustomAUctionUnSold"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">


    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <models:CowTypeToStyleConverter_V2 x:Key="CowTypeToStyleConverter_V2"/>
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:WeightKGConverter x:Key="WeightKGConverter"/>
        <models:SelectShowWeight_EPDString x:Key="SelectShowWeight_EPDString" />
    </UserControl.Resources>

    <Border BorderThickness="2" BorderBrush="OrangeRed">
        <Grid Background="black" >

            <!-- "유찰"을 표시하는 TextBlock -->
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Text="유    찰" FontSize="25" Foreground="#e5081b" FontWeight="Bold"/>

            <Canvas Margin="2,30,0,0">
                <TextBlock Text="{Binding Sex}" Style="{Binding CopyGValues, Converter={StaticResource CowTypeToStyleConverter_V2}}" VerticalAlignment="Top" x:Name="Sex"/>
            </Canvas>

            <Canvas Margin="0,35,0,0">
                <TextBlock Text="최저 : "  Foreground="lime"  Margin="2,0,0,0"/>
                <TextBlock Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}}" Margin="40,0,0,0" Foreground="Yellow"/>
            </Canvas>



            <Canvas Visibility="{Binding SelectShowWeight_EPD, Converter={StaticResource SelectShowWeight_EPDString}, ConverterParameter=ShowWeight}">
                <Canvas Margin="0,50,0,0">
                    <TextBlock Text="중량 : "  Foreground="lime" Margin="2,0,0,0"/>
                    <TextBlock Text="{Binding Weight, Converter={StaticResource WeightKGConverter}}" Margin="40,0,0,0" Foreground="Yellow"/>
                </Canvas>
            </Canvas>

            <Canvas Visibility="{Binding SelectShowWeight_EPD, Converter={StaticResource SelectShowWeight_EPDString}, ConverterParameter=ShowEPD}">
                <Canvas Margin="0,50,0,0">
                    <TextBlock Text="육종:"  Foreground="lime" Margin="2,0,0,0"/>
                    <TextBlock Text="{Binding bodyWeightInColdString}" Margin="30,0,0,0" Foreground="Silver" FontWeight="Bold"/>
                    <TextBlock Text="{Binding longestMuscleCrossSectionString}" Margin="40,0,0,0" Foreground="Silver" FontWeight="Bold"/>
                    <TextBlock Text="{Binding fatThicknessOnBackString}" Margin="50,0,0,0" Foreground="Silver" FontWeight="Bold"/>
                    <TextBlock Text="{Binding intramuscularFatContentString}" Margin="60,0,0,0" Foreground="Silver" FontWeight="Bold"/>
                </Canvas>
            </Canvas>

            <Canvas Margin="0,65,0,0">
                <!-- 생년월일 -->
                <TextBlock Text="{Binding Birth}" Foreground="Cyan" Margin="2,0,0,0"/>
            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
            <Canvas Margin="0,80,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="{Binding StrCowDistinction}"   Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction"/>
                <TextBlock Text="{Binding EntityNumber}" Margin="44,0,0,0" Foreground="{DynamicResource EntityNumberForeground}"/>
                <TextBlock Text="{Binding EntityNumberShort}" Margin="72,0,0,0" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}"/>
            </Canvas>
            <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas -->
            <Canvas Margin="0,80,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
                <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0" />
                <TextBlock Text="{Binding SipNumber}" Margin="40,0,0,0" Foreground="Silver" Background="Black" FontWeight="Bold"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->

            <Canvas Margin="0,95,0,0">
                <TextBlock Text="{Binding Location}"  Foreground="lime" Margin="2,0,0,0"/>
                <TextBlock Text="{Binding OwnerName}" Margin="28,0,0,0" Foreground="Cyan"/>
            </Canvas>

            <!-- Note를 표시하는 TextBlock -->
            <Canvas x:Name="canvas" ClipToBounds="True" Margin="2,111,2,1">
                <TextBlock x:Name="note" Text="{Binding Note}" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#f61c2d" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" RenderTransformOrigin="0,0"/>
            </Canvas>

        </Grid>
    </Border>


</UserControl>

