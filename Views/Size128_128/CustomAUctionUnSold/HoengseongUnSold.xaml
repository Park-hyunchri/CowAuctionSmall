<UserControl x:Class="CowAuctionSmall.Views.Size128_128.CustomAUctionUnSold.HoengseongUnSold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.CustomAUctionUnSold"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             Height="128" Width="128">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
    </UserControl.Resources>

    <Grid Background="black">
        <Border BorderThickness="2" BorderBrush="OrangeRed"/>
        <Grid>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Text="유    찰" FontSize="25" Foreground="#e5081b" FontWeight="Bold"/>

            <Canvas Margin="2,30,0,0">
                <TextBlock Text="{Binding Sex}" Style="{Binding CopyGValues, Converter={StaticResource CowTypeToStyleConverter_V3}}" VerticalAlignment="Top" x:Name="Sex"/>
            </Canvas>

            <!-- 내정/시중/최저가 -->
            <TextBlock Margin="2,25,0,0" FontSize="13">
                <Run Text="{Binding LowestPriceTitle, StringFormat='{}{0} : '}"/>
                <Run Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="Yellow"/>
            </TextBlock>

            <TextBlock Margin="2,41,0,0" FontSize="13">
                <Run Text="중량 : " Foreground="lime"/>
                <Run Text="{Binding Weight}" Foreground="Yellow"/>
            </TextBlock>

            <TextBlock Margin="2,57,0,0" Text="{Binding Birth}" Foreground="Cyan" FontSize="12"/>

            <!-- 개체번호 -->
            <Canvas Margin="0,73,0,0">
                <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0" FontSize="13"/>
                <TextBlock Text="{Binding EntityNumber}" Margin="42,0,0,0" Foreground="{DynamicResource EntityNumberForeground}" FontSize="13"/>
                <TextBlock Text="{Binding CowInfo.EntityNumberShort}" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" FontSize="13"/>
            </Canvas>

            <!-- 지역 / 농가명 -->
            <TextBlock Margin="2,89,0,0" FontSize="12">
                <Run Text="{Binding Location}" Foreground="{DynamicResource LocationForeground}"/>
                <Run Text=" "/>
                <Run Text="{Binding OwnerName}" Foreground="Cyan"/>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>