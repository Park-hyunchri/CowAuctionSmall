<UserControl x:Class="CowAuctionSmall.Views.Size128_128.GoatSold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:noteStyle="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128"
                          xmlns:models="clr-namespace:CowAuctionSmall.Presentation.Converters"
             xmlns:common="clr-namespace:CowAuctionSmall.Views.Common"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <!-- 염소 낙찰 페이지 -->
    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border DataContext="{Binding Snapshot}" BorderBrush="#1E90FF" BorderThickness="2">

        <Grid Background="Black">

            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" HorizontalAlignment="Center" VerticalAlignment="Top" Text="낙    찰" FontSize="22" Foreground="Violet" FontWeight="Bold"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"  HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#F2F2F2" Margin="0,0,0,0"  Background="Black" FontWeight="Regular">
                <Run Text="경매번호 : " Foreground="lime"/>
                <Run Text="{Binding SipNumber}" Foreground="White"/>
            </TextBlock>

            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="최저가 :"  Foreground="lime" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0"/>
            <TextBlock  Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding DataContext.LowestPriceText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:GoatSold}}}" Foreground="Yellow" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>


            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal"  VerticalAlignment="Center" Margin="0,0,0,0">

                <TextBlock Text="중량" Foreground="lime" Margin="6,0,0,0"/>
                <TextBlock Text=":" Foreground="lime" Margin="11,0,0,0"/>
                <TextBlock Foreground="Cyan" Margin="7,0,0,0">
                    <Run Text="{Binding DataContext.FormattedWeightText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:GoatSold}}}" Foreground="Orange"/>
                    <Run Text="kg" Foreground="Orange"/>
                </TextBlock>
            </StackPanel>

            <!-- 낙찰가 : 라벨 -->
            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="낙찰가"  Foreground="WhiteSmoke" VerticalAlignment="Center" Margin="2,0,0,0"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text=":"  Foreground="WhiteSmoke" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="41,0,0,0"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding DataContext.BidPriceText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:GoatSold}}}" Foreground="WhiteSmoke" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>



            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="낙찰자" Foreground="Violet" FontSize="12" Margin="2,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"  Text=":" Foreground="Violet" FontSize="12" Margin="42,0,0,0" VerticalAlignment="Center"/>

            <Grid Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="5"  HorizontalAlignment="Stretch" VerticalAlignment="Center">

                <!-- N : 숫자만 (현재와 동일한 형태) -->
                <TextBlock x:Name="tbBidderNumberOnly" Text="{Binding Bidder}" Foreground="Yellow" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-18,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BidderName}" Value="N">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Y : 사람 이름만 (5글자 초과 시 한 줄 흐름) -->
                <common:BidderNameFlow Text="{Binding Bidder}"
                                       FontWeight="Bold"
                                       Height="20"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"
                                       Margin="0,4,0,0">
                    <common:BidderNameFlow.Style>
                        <Style TargetType="{x:Type common:BidderNameFlow}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BidderName}" Value="Y">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </common:BidderNameFlow.Style>
                </common:BidderNameFlow>


                <!-- B : 윗줄 이름, 아랫줄 숫자 -->
                <StackPanel x:Name="spBidderNumberAndName" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,0,0,0" >
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BidderName}" Value="B">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- 윗줄 : 이름 (5글자 초과 시 한 줄 흐름) -->
                    <common:BidderNameFlow Text="{Binding BidderString}"
                                           Height="13" FontSize="12"
                                           HorizontalAlignment="Stretch" />

                    <!-- 아랫줄 : 숫자 -->
                    <TextBlock Foreground="Yellow" FontSize="12" TextAlignment="Center" FontWeight="Regular" Margin="-30,1,0,0">
                        <Run Text="("/>
                        <Run Text="{Binding BidderNum}" />
                        <Run Text=")"/>
                    </TextBlock>

                </StackPanel>
            </Grid>

            <!-- Note를 표시하는 TextBlock -->
            <Canvas Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5" x:Name="canvas" ClipToBounds="True" Margin="2,3,2,0">
                <TextBlock x:Name="note" noteStyle:NoteText.Normal="{Binding Note}" noteStyle:NoteText.History="{Binding NoteChangeOwner}" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#f61c2d" FontWeight="Regular" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" RenderTransformOrigin="0,0"/>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
