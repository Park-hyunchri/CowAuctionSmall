<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1.YangpyeongRun"
             xmlns:entity="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1"
             xmlns:models="clr-namespace:CowAuctionSmall.Presentation.Converters"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <!-- 양평축협 전용 러닝 페이지 (송아지: 육종 / 비육우·번식우: 중량 & 임신) -->
    <UserControl.Resources>
        <Style x:Key="BlinkingBorderStyle2" TargetType="Border">
            <Setter Property="BorderBrush" Value="black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType={x:Type local:YangpyeongRun}}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.BorderBrush)" Duration="0:0:1">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="Black"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="#FD3A4A"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:BloodFontStyle x:Key="BloodFontStyle"/>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="AbcdColorStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Regular"/>
            <!-- 💡users.xml 파일의 <EpdGradeForeground> 옵션값(동적 브러시)을 적용 -->
            <Setter Property="Foreground" Value="{DynamicResource EpdGradeForeground}"/>
        </Style>
    </UserControl.Resources>

    <Border BorderThickness="3" Style="{StaticResource BlinkingBorderStyle2}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid DataContext="{Binding CowInfo}">
            <!-- 우측 성별 표시 -->
            <Canvas Margin="0,17,0,0">
                <TextBlock Style="{StaticResource SexTextV3}" DataContext="{Binding DataContext.ItemDisplay, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:YangpyeongRun}}}" VerticalAlignment="Top" x:Name="Sex"/>
            </Canvas>

            <!-- 1행: 축종 / 개체관리번호 (users.xml 동적 색상 적용) -->
            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="{Binding StrCowDistinction}" Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction"/>
                <entity:EntityNumberText Number="{Binding EntityNumber}" Margin="44,0,0,0" Foreground="{DynamicResource EntityNumberForeground}" HighlightForeground="{DynamicResource EntityNumberShortForeground}" Style="{StaticResource {x:Type TextBlock}}" />
            </Canvas>
            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
                <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0"/>
                <TextBlock Text="{Binding SipNumber}" Margin="40,0,0,0" Foreground="Silver" Background="Black" FontWeight="Bold"/>
            </Canvas>

            <!-- 2행: 출하지역 색상값 (users.xml 동적 색상 적용) -->
            <TextBlock Margin="2,16,0,0">
                <Run Text="{Binding Location}" Foreground="{DynamicResource LocationForeground}"/>
                <Run Text=" "/>
                <Run Text="{Binding OwnerName}" Foreground="Cyan"/>
            </TextBlock>

            <!-- 3행: 최저가 -->
            <TextBlock Margin="2,32,0,0" Foreground="lime">
                <Run Text="최저 : "/>
                <Run Text="{Binding DataContext.ItemDisplay.LowestPriceText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:YangpyeongRun}}}" Foreground="Yellow"/>
            </TextBlock>

            <!-- 4행 (송아지: 1) -> 육종 표출 -->
            <StackPanel Orientation="Horizontal" Margin="2,47,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CowDistinction}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="육종 : " Foreground="lime"/>
                <TextBlock Text="{Binding bodyWeightInColdString}" Style="{StaticResource AbcdColorStyle}"/>
                <TextBlock Text="{Binding longestMuscleCrossSectionString}" Style="{StaticResource AbcdColorStyle}"/>
                <TextBlock Text="{Binding fatThicknessOnBackString}" Style="{StaticResource AbcdColorStyle}"/>
                <TextBlock Text="{Binding intramuscularFatContentString}" Style="{StaticResource AbcdColorStyle}"/>
            </StackPanel>

            <!-- 4행 (비육우: 2 / 번식우: 3) -> 중량 표출 -->
            <TextBlock Margin="2,47,0,0" Foreground="lime">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CowDistinction}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CowDistinction}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="중량 : "/>
                <Run Text="{Binding DataContext.ItemDisplay.WeightWithUnitText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:YangpyeongRun}}}" Foreground="Yellow"/>
            </TextBlock>
            
            <!-- 💡 4행 우측: 임신 (계대, 산차 라인의 X=75 위치와 정확히 수직 일치) -->
            <Canvas Margin="75,47,0,0">
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ItemDisplay.ShowPregnancy, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:YangpyeongRun}}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>
                <TextBlock Foreground="lime">
                    <Run Text="임신 : "/>
                    <Run Text="{Binding Pregnant}" Foreground="Yellow"/>
                </TextBlock>
            </Canvas>

            <!-- 5행: 생년월일 / 개월수 -->
            <TextBlock Text="{Binding Birth}" Foreground="Cyan" Margin="2,62,0,0"/>

            <!-- 6행: 등록 / 계대 (X=75 라인) -->
            <Canvas Margin="2,77,50,0">
                <TextBlock Text="등록 :" Foreground="lime"/>
                <TextBlock Text="{Binding RegistrationCategory, Converter={StaticResource MotherLevelConverter}}" Style="{Binding RegistrationCategory, Converter={StaticResource BloodFontStyle}}"/>
            </Canvas>
            <TextBlock Margin="75,77,0,30" Foreground="lime">
                <Run Text="계대 : "/>
                <Run Text="{Binding Blood}" Foreground="Orange"/>
            </TextBlock>

            <!-- 7행: KPN / 산차 (X=75 라인) -->
            <TextBlock Margin="2,92,50,0" Foreground="lime">
                <Run Text="KPN : "/>
                <Run Text="{Binding KPN}" Foreground="Orange"/>
            </TextBlock>
            <TextBlock Margin="75,92,0,0" Foreground="lime">
                <Run Text="산차 : "/>
                <Run Text="{Binding CalvingNumber}" Foreground="Orange"/>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>