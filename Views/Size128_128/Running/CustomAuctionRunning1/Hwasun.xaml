<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1.Hwasun"
             xmlns:entity="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1"
             xmlns:models="clr-namespace:CowAuctionSmall.Presentation.Converters"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <!-- 정읍 경매 페이지1 _ 중량대신에 유전능력값 알파벳만 넣었음 -->
    <UserControl.Resources>
        <Style x:Key="BlinkingBorderStyle2" TargetType="Border">
            <Setter Property="BorderBrush" Value="black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType={x:Type local:Hwasun}}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames
                                    Storyboard.TargetProperty="(Border.BorderBrush)"
                                    Duration="0:0:1">
                                    <!-- 검정색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="Black"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>

                                    <!-- 빨간색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="#FD3A4A"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 추가 -->
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:BloodFontStyle x:Key="BloodFontStyle"/>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Border BorderThickness="3" Style="{StaticResource BlinkingBorderStyle2}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid DataContext="{Binding CowInfo}">

            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}" Margin="0,17,0,0">
                <TextBlock Style="{StaticResource SexTextV3}" DataContext="{Binding DataContext.ItemDisplay, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Hwasun}}}" VerticalAlignment="Top" x:Name="Sex"/>
            </Canvas>

            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}" Margin="0,5,0,0">
                <TextBlock Style="{StaticResource SexTextV3}" DataContext="{Binding DataContext.ItemDisplay, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Hwasun}}}" VerticalAlignment="Top"/>
            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0" />
                <entity:EntityNumberText Number="{Binding EntityNumber}" Margin="40,0,0,0" Foreground="{DynamicResource EntityNumberForeground}" HighlightForeground="{DynamicResource EntityNumberShortForeground}" Style="{StaticResource {x:Type TextBlock}}" />
            </Canvas>
            <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas -->
            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
                <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0" />
                <TextBlock Text="{Binding SipNumber}" Margin="40,0,0,0" Foreground="Silver" Background="Black" FontWeight="Bold"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->
            <Canvas Margin="0,16,0,0">
                <TextBlock Text="{Binding Location}"  Foreground="{DynamicResource LocationForeground}"  Margin="2,0,0,0"/>
                <TextBlock Text="{Binding OwnerName}" Margin="28,0,0,0" Foreground="Cyan"/>
            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}"  Margin="0,32,0,0" >
                <TextBlock Text="최저 : "  Foreground="lime"  Margin="2,0,0,0"/>
                <TextBlock Text="{Binding DataContext.ItemDisplay.LowestPriceText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Hwasun}}}" Margin="40,0,0,0" Foreground="Yellow"/>
            </Canvas>

            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}"  Margin="0,32,0,0" >
                <TextBlock Text="최저 : "  Foreground="lime"  Margin="2,0,0,0"/>
                <TextBlock Text="{Binding DataContext.ItemDisplay.LowestPriceText, Mode=OneWay, StringFormat={}{0} 천원, RelativeSource={RelativeSource AncestorType={x:Type local:Hwasun}}}" Margin="40,0,0,0" Foreground="Yellow"/>

            </Canvas>
            <!-- ======================================================================================================================================================================= -->

            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}" Margin="0,47,0,0">
                <TextBlock Text="육종:"  Foreground="lime" Margin="2,0,0,0"/>
                <TextBlock Text="{Binding bodyWeightInColdString}" Margin="30,0,0,0" Foreground="{DynamicResource EpdGradeForeground}" FontWeight="Bold"/>
                <TextBlock Text="{Binding longestMuscleCrossSectionString}" Margin="40,0,0,0" Foreground="{DynamicResource EpdGradeForeground}" FontWeight="Bold"/>
                <TextBlock Text="{Binding fatThicknessOnBackString}" Margin="50,0,0,0" Foreground="{DynamicResource EpdGradeForeground}" FontWeight="Bold"/>
                <TextBlock Text="{Binding intramuscularFatContentString}" Margin="60,0,0,0" Foreground="{DynamicResource EpdGradeForeground}" FontWeight="Bold"/>
            </Canvas>

            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}" Margin="0,47,0,0">
                <TextBlock Text="중량 : "  Foreground="lime" Margin="2,0,0,0"/>
                <TextBlock Text="{Binding DataContext.ItemDisplay.WeightWithUnitText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Hwasun}}}" Margin="40,0,0,0" Foreground="Yellow"/>
            </Canvas>

            <Canvas Margin="70,47,0,0" >
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ItemDisplay.ShowPregnancy, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Hwasun}}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>
                <TextBlock Text="임신 : "  Foreground="lime" Margin="2,0,0,0"/>
                <TextBlock Text="{Binding Pregnant}" Margin="40,0,0,0" Foreground="Yellow"/>
            </Canvas>

            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <Canvas Margin="0,62,0,0">
                    <!-- 생년월일 -->
                    <TextBlock Text="{Binding Birth}" Foreground="Cyan" Margin="2,0,0,0"/>
                </Canvas>

                <Canvas Margin="0,77,0,0">
                    <TextBlock Text="등록 : "  Foreground="lime" Margin="2,0,0,0"/>
                    <TextBlock Text="{Binding RegistrationCategory, Converter={StaticResource MotherLevelConverter}}" Style="{Binding RegistrationCategory, Converter={StaticResource BloodFontStyle}}"  Margin="40,0,0,0" />
                </Canvas>

                <Canvas Margin="70,77,0,0">
                    <TextBlock Text="계대 : "  Foreground="lime" Margin="2,0,0,0"/>
                    <TextBlock Text="{Binding Blood}" Margin="40,0,0,0" Foreground="Orange"/>
                </Canvas>

                <Canvas Margin="0,92,0,0">
                    <TextBlock Text="KPN : "  Foreground="lime" Margin="2,0,0,0"/>
                    <TextBlock Text="{Binding KPN}" Margin="40,0,0,0" Foreground="Orange"/>
                </Canvas>

                <Canvas Margin="70,92,0,0">
                    <TextBlock Text="산차 : "  Foreground="lime" Margin="2,0,0,0"/>
                    <TextBlock Text="{Binding CalvingNumber}" Margin="40,0,0,0" Foreground="Orange"/>
                </Canvas>
            </Canvas>
            <!-- Note를 표시하는 TextBlock -->
</Grid>
    </Border>

</UserControl>
