<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1.HaenamJindo"
             xmlns:entity="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1"
             xmlns:models="clr-namespace:CowAuctionSmall.Presentation.Converters"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased"
             TextOptions.TextHintingMode="Fixed"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <!-- 해남진도축협 러닝 페이지 적용 -->
    <UserControl.Resources>

        <!-- 추가 -->
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:ShowMatherBloodConverter x:Key="ShowMatherBloodConverter" />
        <models:SelectShowWeight_EPDString x:Key="SelectShowWeight_EPDString" />
        <models:BorderOutlineConverter x:Key="BorderOutlineConverter"/>
        <models:BloodFontStyle x:Key="BloodFontStyle"/>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

    </UserControl.Resources>

    <Border BorderThickness="3"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid DataContext="{Binding CowInfo}">
            <Canvas x:Name="LedCanvas" IsHitTestVisible="False" Margin="-3"/>

            <Canvas Margin="0,17,0,0">
                <TextBlock Style="{StaticResource SexTextV3}" DataContext="{Binding DataContext.ItemDisplay, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:HaenamJindo}}}" VerticalAlignment="Top" x:Name="Sex" ></TextBlock>
            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="{Binding StrCowDistinction}" Margin="2,0,0,0" Foreground="#FFD700"  x:Name="StrCowDistinction" FontSize="11" FontWeight="Bold"/>
                <!-- 전체 개체관리번호 (users.xml 동적 색상 적용) -->
                <entity:EntityNumberText Number="{Binding EntityNumber}" Margin="40,0,0,0" Foreground="{DynamicResource EntityNumberForeground}" FontSize="12" FontWeight="SemiBold" Style="{StaticResource {x:Type TextBlock}}" />
            </Canvas>
            <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas -->
            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
                <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding SipNumber}" Margin="40,0,0,0" Foreground="Silver" Background="Black" FontWeight="Bold" FontSize="11"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->
            <Canvas Margin="0,13,0,0">
                <TextBlock Text="{Binding Location}"  Foreground="{DynamicResource LocationForeground}"  Margin="2,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding OwnerName}" Margin="28,0,0,0" Foreground="#FFD700" FontSize="11"/>
            </Canvas>

            <Canvas Margin="0,24,0,0">
                <TextBlock Text="KPN : "  Foreground="lime"  Margin="2,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding KPN}" Margin="35,0,0,0" Foreground="#FFD700" FontSize="11"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->
            <!-- 해남진도축협: KPN 아래에 개체 등록구분(기초/혈통/고등/미등록)을 항상 표출 -->
            <Canvas>
                <Canvas Margin="0,35,0,0">
                    <TextBlock Text="등록 : "  Foreground="lime" Margin="2,0,0,0" FontSize="11"/>
                    <!-- HaenamJindo 매개변수 지정 시 미등을 미등록으로 변환 -->
                    <TextBlock Text="{Binding RegistrationCategory, Converter={StaticResource MotherLevelConverter}, ConverterParameter=HaenamJindo}" Foreground="#FFD700" Style="{Binding RegistrationCategory, Converter={StaticResource BloodFontStyle}}"  Margin="36,0,0,0" FontSize="11"/>
                </Canvas>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->
            <Canvas Margin="0,47,0,0">
                <!-- 생년월일 -->
                <TextBlock Text="{Binding BirthMonth}" Foreground="Cyan" Margin="2,0,0,0" FontSize="11"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->

            <Canvas Margin="0,59,0,0">
                <TextBlock Text="어미 : "  Foreground="lime" Margin="2,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding MatherEntityNumber}" Margin="35,0,0,0" Foreground="Yellow" FontSize="11"/>
            </Canvas>
                <!-- ======================================================================================================================================================================= -->

            <Canvas Margin="0,71,0,0">
                <!-- qmfn -->
                <TextBlock Text="브루셀라:"  Foreground="#FF0064" Margin="2,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding brucellosisTestDate}" Foreground="#FF0064"  Margin="50,0,0,0" FontSize="11" />
            </Canvas>

            <Canvas Margin="0,83,0,0">
                <!-- 생년월일 -->
                <TextBlock Text="구 제 역"  Foreground="#FF0064" Margin="2,0,0,0" FontSize="11"/>
                <TextBlock Text=":"  Foreground="#FF0064" Margin="46,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding footAndMouthDiseaseTestDate}" Foreground="#FF0064" Margin="50,0,0,0" FontSize="11" />
            </Canvas>

            <Canvas Margin="0,95,0,0">
                <TextBlock Text="최저"  Foreground="lime" Margin="2,0,0,0" FontSize="13" FontWeight="Bold"/>
                <TextBlock Text="{Binding DataContext.ItemDisplay.LowestPriceOrDashText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:HaenamJindo}}}" Margin="32,0,0,0" Foreground="Yellow" FontSize="13" FontWeight="Bold"/>
            </Canvas>

            <Canvas Margin="75,97,0,0">
                <TextBlock Text="산차"  Foreground="lime" Margin="5,0,0,0" FontSize="11"/>
                <TextBlock Text=":"  Foreground="lime" Margin="30,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding CalvingNumber}" Margin="35,0,0,0" Foreground="Yellow" FontSize="11"/>
            </Canvas>
</Grid>
    </Border>

</UserControl>
