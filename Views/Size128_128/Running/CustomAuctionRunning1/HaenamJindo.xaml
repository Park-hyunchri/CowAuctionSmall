<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1.HaenamJindo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased"
             TextOptions.TextHintingMode="Fixed"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <!-- 해남진도축협 러닝 페이지 적용 -->
    <UserControl.Resources>

        <!-- 추가 -->
        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:PregnancyValueConverter  x:Key="PregnancyValueConverter" />
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:WeightKGConverter x:Key="WeightKGConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:ShowMatherBloodConverter x:Key="ShowMatherBloodConverter" />
        <models:SelectShowWeight_EPDString x:Key="SelectShowWeight_EPDString" />
        <models:BorderOutlineConverter x:Key="BorderOutlineConverter"/>
        <models:BloodFontStyle x:Key="BloodFontStyle"/>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

    </UserControl.Resources>

    <Border BorderThickness="3"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid>
            <Canvas x:Name="LedCanvas" IsHitTestVisible="False" Margin="-3"/>

            <Canvas Margin="0,17,0,0">
                <TextBlock Text="{Binding CowInfo.Sex}" Style="{Binding CowInfo, Converter={StaticResource CowTypeToStyleConverter_V3}}" VerticalAlignment="Top" x:Name="Sex" ></TextBlock>
            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
            <Canvas Visibility="{Binding CowInfo.CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="{Binding CowInfo.StrCowDistinction}" Margin="2,0,0,0" Foreground="#FFD700"  x:Name="StrCowDistinction" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="{Binding CowInfo.EntityNumber}" Margin="40,0,0,0" Foreground="{DynamicResource EntityNumberForeground}" FontSize="12" FontWeight="SemiBold"/>
            </Canvas>
            <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas -->
            <Canvas Visibility="{Binding CowInfo.CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
                <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding CowInfo.SipNumber}" Margin="40,0,0,0" Foreground="Silver" Background="Black" FontWeight="Bold" FontSize="11"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->
            <Canvas Margin="0,13,0,0">
                <TextBlock Text="{Binding CowInfo.Location}"  Foreground="Magenta"  Margin="2,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding CowInfo.OwnerName}" Margin="28,0,0,0" Foreground="#FFD700" FontSize="11"/>
            </Canvas>

            <Canvas Margin="0,24,0,0">
                <TextBlock Text="KPN : "  Foreground="lime"  Margin="2,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding CowInfo.KPN}" Margin="35,0,0,0" Foreground="#FFD700" FontSize="11"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->

            <!-- ======================================================================================================================================================================= -->
            <Canvas Visibility="{Binding CowInfo.RegistrationCategory, Converter={StaticResource ShowMatherBloodConverter}, ConverterParameter=MyBlood}">
                <Canvas Margin="0,35,0,0">
                    <TextBlock Text="등록 : "  Foreground="lime" Margin="2,0,0,0" FontSize="11"/>
                    <TextBlock Text="{Binding CowInfo.RegistrationCategory, Converter={StaticResource MotherLevelConverter}}" Foreground="#FFD700" Style="{Binding CowInfo.RegistrationCategory, Converter={StaticResource BloodFontStyle}}"  Margin="36,0,0,0" FontSize="11"/>
                </Canvas>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->
            <Canvas Margin="0,47,0,0">
                <!-- 생년월일 -->
                <TextBlock Text="{Binding CowInfo.BirthMonth}" Foreground="Cyan" Margin="2,0,0,0" FontSize="11"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->

            <Canvas Margin="0,59,0,0">
                <TextBlock Text="어미 : "  Foreground="lime" Margin="2,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding CowInfo.MatherEntityNumber}" Margin="35,0,0,0" Foreground="Yellow" FontSize="11"/>
            </Canvas>
                <!-- ======================================================================================================================================================================= -->

            <Canvas Margin="0,71,0,0">
                <!-- qmfn -->
                <TextBlock Text="브루셀라:"  Foreground="#FF0064" Margin="2,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding CowInfo.brucellosisTestDate}" Foreground="#FF0064"  Margin="50,0,0,0" FontSize="11" />
            </Canvas>

            <Canvas Margin="0,83,0,0">
                <!-- 생년월일 -->
                <TextBlock Text="구 제 역"  Foreground="#FF0064" Margin="2,0,0,0" FontSize="11"/>
                <TextBlock Text=":"  Foreground="#FF0064" Margin="46,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding CowInfo.footAndMouthDiseaseTestDate}" Foreground="#FF0064" Margin="50,0,0,0" FontSize="11" />
            </Canvas>

            <Canvas Margin="0,95,0,0">
                <TextBlock Text="최저"  Foreground="lime" Margin="2,0,0,0" FontSize="13" FontWeight="Bold"/>
                <TextBlock Text="{Binding CowInfo.LowestPrice, Converter={StaticResource NumberFormatConverter}, ConverterParameter=-}" Margin="32,0,0,0" Foreground="Yellow" FontSize="13" FontWeight="Bold"/>
            </Canvas>

            <Canvas Margin="75,97,0,0">
                <TextBlock Text="산차"  Foreground="lime" Margin="5,0,0,0" FontSize="11"/>
                <TextBlock Text=":"  Foreground="lime" Margin="30,0,0,0" FontSize="11"/>
                <TextBlock Text="{Binding CowInfo.CalvingNumber}" Margin="35,0,0,0" Foreground="Yellow" FontSize="11"/>
            </Canvas>

            
            <!-- Note를 표시하는 TextBlock -->
</Grid>
    </Border>

</UserControl>
