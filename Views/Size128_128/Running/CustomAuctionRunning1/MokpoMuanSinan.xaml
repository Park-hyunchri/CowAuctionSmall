<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1.MokpoMuanSinan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             xmlns:modelsMokpo="clr-namespace:CowAuctionSmall.Models.Converter.Mokpo"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <!-- 목무신축협 러닝 페이지 적용 -->
    <UserControl.Resources>
        <Style x:Key="BlinkingBorderStyle2" TargetType="Border">
            <Setter Property="BorderBrush" Value="black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames
                                    Storyboard.TargetProperty="(Border.BorderBrush)"
                                    Duration="0:0:1">
                                    <!-- 검정색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="Black"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>

                                    <!-- 빨간색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="#FD3A4A"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 추가 -->
        <models:CowTypeToStyleConverter_V2 x:Key="CowTypeToStyleConverter_V2"/>
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:PregnancyValueConverter  x:Key="PregnancyValueConverter" />
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:WeightKGConverter x:Key="WeightKGConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:ShowMatherBloodConverter x:Key="ShowMatherBloodConverter" />
        <models:BorderOutlineConverter x:Key="BorderOutlineConverter"/>
        <models:BloolFontStyle x:Key="BloolFontStyle"/>
        
        <modelsMokpo:MokpoEPD x:Key="MokpoEPD"/>

        <models:SelectShowWeightEpdMultiConverter x:Key="SelectShowWeightEpdMultiConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

    </UserControl.Resources>

    <Border BorderThickness="3" Style="{StaticResource BlinkingBorderStyle2}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid>

            <Canvas Margin="0,17,0,0">
                <TextBlock Text="{Binding CowInfo.Sex}" Style="{Binding CowInfo, Converter={StaticResource CowTypeToStyleConverter_V2}}" VerticalAlignment="Top" x:Name="Sex" ></TextBlock>
            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
            <Canvas Visibility="{Binding CowInfo.CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="{Binding CowInfo.StrCowDistinction}"   Style="{Binding CowInfo.StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction"/>
                <TextBlock Text="{Binding CowInfo.EntityNumber}" Margin="44,0,0,0" Foreground="{DynamicResource EntityNumberForeground}"/>
                <TextBlock Text="{Binding CowInfo.EntityNumberShort}" Margin="72,0,0,0" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->
            <TextBlock Margin="0,16,0,0" Foreground="lime" FontSize="11">
                <Run Text="{Binding CowInfo.Location}"/>
                <Run Text=" "/>
                <Run Text="{Binding CowInfo.OwnerName}" Foreground="Cyan"/>
            </TextBlock>

            <TextBlock Margin="0,31,0,0" Foreground="lime">
                <Run Text="최저 :"/>
                <Run Text="{Binding CowInfo.LowestPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="Yellow"/>
            </TextBlock>
            <!-- ======================================================================================================================================================================= -->
            <!-- EPD 표시용 -->
            <Canvas>
                <Canvas.Visibility>
                    <!-- select == "N" && CowDistinction in {1,3} 일 때 Visible -->
                    <MultiBinding Converter="{StaticResource MokpoEPD}" ConverterParameter="ShowEPD:1,3">
                        <Binding Path="CowInfo.SelectShowWeight_EPD"/>
                        <Binding Path="CowInfo.CowDistinction"/>
                    </MultiBinding>
                </Canvas.Visibility>

                <Canvas Margin="0,47,0,0">
                    <TextBlock Text="육종:"  Foreground="lime" />
                    <TextBlock Text="{Binding CowInfo.bodyWeightInColdString}" Margin="30,0,0,0" Foreground="Silver" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CowInfo.longestMuscleCrossSectionString}" Margin="40,0,0,0" Foreground="Silver" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CowInfo.fatThicknessOnBackString}" Margin="50,0,0,0" Foreground="Silver" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CowInfo.intramuscularFatContentString}" Margin="60,0,0,0" Foreground="Silver" FontWeight="Bold"/>
                </Canvas>
            </Canvas>

            <!-- CowDistinction == 2 일 때만 보이는 영역 (Select 무시) -->
            <Canvas>
                <Canvas.Visibility>
                    <MultiBinding Converter="{StaticResource MokpoEPD}" ConverterParameter="2">
                        <Binding Path="CowInfo.SelectShowWeight_EPD"/>
                        <Binding Path="CowInfo.CowDistinction"/>
                    </MultiBinding>
                </Canvas.Visibility>

                <Canvas Margin="0,47,0,0">
                    <!-- 예: 2번 전용 표시 -->
                    <TextBlock Text="어미 : " Foreground="lime" />
                    <TextBlock Text="{Binding CowInfo.MatherEntityNumber}" Margin="40,0,0,0" Foreground="Yellow"/>
                </Canvas>

            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <Canvas Margin="70,47,0,0" >
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CowInfo.Pregnant, Converter={StaticResource PregnancyValueConverter}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>
                <TextBlock Text="임신 : "  Foreground="lime" Margin="2,0,0,0"/>
                <TextBlock Text="{Binding CowInfo.Pregnant}" Margin="40,0,0,0" Foreground="Yellow"/>
            </Canvas>

            <!-- 생년월일 -->
            <TextBlock Text="{Binding CowInfo.Birth}" Foreground="Cyan" Margin="2,62,0,43"/>

            <!-- ======================================================================================================================================================================= -->
            <Canvas Margin="2,78,50,0">
                <TextBlock Text="등록 :" Foreground="lime"/>
                <TextBlock Text="{Binding CowInfo.RegistrationCategory, Converter={StaticResource MotherLevelConverter}}"  Style="{Binding CowInfo.RegistrationCategory, Converter={StaticResource BloolFontStyle}}"/>
            </Canvas>

            <TextBlock Margin="75,78,0,30" Foreground="lime">
                <Run Text="계대 :"/>
                <Run Text="{Binding CowInfo.Blood}" Foreground="Orange"/>
            </TextBlock>

            <TextBlock Margin="2,93,50,0" Foreground="lime">
                <Run Text="KPN :"/>
                <Run Text="{Binding CowInfo.KPN}" Foreground="Orange"/>
            </TextBlock>

            <TextBlock Margin="75,93,0,0" Foreground="lime">
                <Run Text="산차 :"/>
                <Run Text="{Binding CowInfo.CalvingNumber}" Foreground="Orange"/>
            </TextBlock>

            <!-- Note를 표시하는 TextBlock -->
</Grid>
    </Border>

</UserControl>
