<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1.MokpoMuanSinan"
             xmlns:entity="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1"
             xmlns:models="clr-namespace:CowAuctionSmall.Presentation.Converters"
             xmlns:modelsMokpo="clr-namespace:CowAuctionSmall.Presentation.Converters.Mokpo"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <!-- 목무신축협 러닝 페이지 적용 -->
    <UserControl.Resources>
        <Style x:Key="BlinkingBorderStyle2" TargetType="Border">
            <Setter Property="BorderBrush" Value="black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType={x:Type local:MokpoMuanSinan}}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames
                                    Storyboard.TargetProperty="(Border.BorderBrush)"
                                    Duration="0:0:1">
                                    <!-- 검정색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="Black"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>

                                    <!-- 빨간색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="#FD3A4A"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 추가 -->
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:ShowMatherBloodConverter x:Key="ShowMatherBloodConverter" />
        <models:BorderOutlineConverter x:Key="BorderOutlineConverter"/>
        <models:BloodFontStyle x:Key="BloodFontStyle"/>
        
        <modelsMokpo:MokpoEPD x:Key="MokpoEPD"/>

        <models:SelectShowWeightEpdMultiConverter x:Key="SelectShowWeightEpdMultiConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

    </UserControl.Resources>

    <Border BorderThickness="3" Style="{StaticResource BlinkingBorderStyle2}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid DataContext="{Binding CowInfo}">

            <Canvas Margin="0,17,0,0">
                <TextBlock Style="{StaticResource SexTextV3}" DataContext="{Binding DataContext.ItemDisplay, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:MokpoMuanSinan}}}" VerticalAlignment="Top" x:Name="Sex" ></TextBlock>
            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="{Binding StrCowDistinction}"   Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction"/>
                <entity:EntityNumberText Number="{Binding EntityNumber}" Margin="44,0,0,0" Foreground="{DynamicResource EntityNumberForeground}" HighlightForeground="{DynamicResource EntityNumberShortForeground}" Style="{StaticResource {x:Type TextBlock}}" />
            </Canvas>
            <!-- ======================================================================================================================================================================= -->
            <!-- 출하지역 색상값 (users.xml 동적 색상 적용) -->
            <TextBlock Margin="0,16,0,0" Foreground="lime" FontSize="11">
                <Run Text="{Binding Location}" Foreground="{DynamicResource LocationForeground}"/>
                <Run Text=" "/>
                <Run Text="{Binding OwnerName}" Foreground="Cyan"/>
            </TextBlock>

            <TextBlock Margin="0,31,0,0" Foreground="lime">
                <Run Text="최저 :"/>
                <Run Text="{Binding DataContext.ItemDisplay.LowestPriceText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:MokpoMuanSinan}}}" Foreground="Yellow"/>
            </TextBlock>
            <!-- ======================================================================================================================================================================= -->
            <!-- 송아지(1), 번식우(3) : 육종(EPD) 표시 -->
            <Canvas>
                <Canvas.Visibility>
                    <!-- select == "N" && CowDistinction in {1,3} 일 때 Visible -->
                    <MultiBinding Converter="{StaticResource MokpoEPD}" ConverterParameter="ShowEPD:1,3">
                        <Binding Path="SelectShowWeight_EPD"/>
                        <Binding Path="CowDistinction"/>
                    </MultiBinding>
                </Canvas.Visibility>

                <!-- 육종 ABCD 색상값 (users.xml 동적 색상 적용) -->
                <Canvas Margin="0,47,0,0">
                    <TextBlock Text="육종:"  Foreground="lime" />
                    <TextBlock Text="{Binding bodyWeightInColdString}" Foreground="{DynamicResource EpdGradeForeground}" Margin="2,0,0,0"/>
                    <TextBlock Text="{Binding longestMuscleCrossSectionString}" Foreground="{DynamicResource EpdGradeForeground}"/>
                    <TextBlock Text="{Binding fatThicknessOnBackString}" Foreground="{DynamicResource EpdGradeForeground}"/>
                    <TextBlock Text="{Binding intramuscularFatContentString}" Foreground="{DynamicResource EpdGradeForeground}"/>
                </Canvas>
            </Canvas>

            <!-- 비육우(2) : 어미 개체관리번호 표시 -->
            <Canvas>
                <Canvas.Visibility>
                    <MultiBinding Converter="{StaticResource MokpoEPD}" ConverterParameter="2">
                        <Binding Path="SelectShowWeight_EPD"/>
                        <Binding Path="CowDistinction"/>
                    </MultiBinding>
                </Canvas.Visibility>

                <Canvas Margin="0,47,0,0">
                    <!-- 예: 2번 전용 표시 -->
                    <TextBlock Text="어미 : " Foreground="lime" />
                    <TextBlock Text="{Binding MatherEntityNumber}" Margin="40,0,0,0" Foreground="Yellow"/>
                </Canvas>

            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <Canvas Margin="70,47,0,0" >
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ItemDisplay.ShowPregnancy, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:MokpoMuanSinan}}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>
                <TextBlock Text="임신 : "  Foreground="lime" Margin="2,0,0,0"/>
                <TextBlock Text="{Binding Pregnant}" Margin="40,0,0,0" Foreground="Yellow"/>
            </Canvas>

            <!-- 생년월일 -->
            <TextBlock Text="{Binding Birth}" Foreground="Cyan" Margin="2,62,0,43"/>

            <!-- ======================================================================================================================================================================= -->
            <Canvas Margin="2,78,50,0">
                <TextBlock Text="등록 :" Foreground="lime"/>
                <TextBlock Text="{Binding RegistrationCategory, Converter={StaticResource MotherLevelConverter}}"  Style="{Binding RegistrationCategory, Converter={StaticResource BloodFontStyle}}"/>
            </Canvas>

            <TextBlock Margin="75,78,0,30" Foreground="lime">
                <Run Text="계대 :"/>
                <Run Text="{Binding Blood}" Foreground="Orange"/>
            </TextBlock>

            <TextBlock Margin="2,93,50,0" Foreground="lime">
                <Run Text="KPN :"/>
                <Run Text="{Binding KPN}" Foreground="Orange"/>
            </TextBlock>

            <TextBlock Margin="75,93,0,0" Foreground="lime">
                <Run Text="산차 :"/>
                <Run Text="{Binding CalvingNumber}" Foreground="Orange"/>
            </TextBlock>
        </Grid>
    </Border>

</UserControl>
