<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1.HoengseongRun"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <!-- 횡성축협 진행 페이지 (두 번째 사진 양식 적용) -->
    <UserControl.Resources>
        <Style x:Key="BlinkingBorderStyle2" TargetType="Border">
            <Setter Property="BorderBrush" Value="black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.BorderBrush)" Duration="0:0:1">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="Black"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="#FD3A4A"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:PregnancyValueConverter x:Key="PregnancyValueConverter" />
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Border BorderThickness="2" Style="{StaticResource BlinkingBorderStyle2}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid>
            <!-- 성별 -->
            <TextBlock Text="{Binding CowInfo.Sex}" Style="{Binding CowInfo, Converter={StaticResource CowTypeToStyleConverter_V3}}" VerticalAlignment="Top" x:Name="Sex">
                <TextBlock.RenderTransform>
                    <TranslateTransform Y="17"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- 1행:개체번호 -->
            <Canvas>
                <TextBlock Text="개체:" Foreground="lime" Margin="2,0,0,0" FontSize="13"/>
                <TextBlock Text="{Binding CowInfo.EntityNumber}" Margin="42,0,0,0" Foreground="{DynamicResource EntityNumberForeground}" FontSize="13"/>
                <TextBlock Text="{Binding CowInfo.EntityNumberShort}" Margin="74,0,0,0" Foreground="Red" Background="Black" FontSize="13"/>
            </Canvas>

            <!-- 2행:출하지역 / 농가명 -->
            <TextBlock Margin="2,16,0,0" Foreground="#7E84F7" FontSize="13">
                <Run Text="{Binding CowInfo.Location}"/>
                <Run Text=" "/>
                <Run Text="{Binding CowInfo.OwnerName}" Foreground="Cyan"/>
            </TextBlock>

            <!-- 3행: 동적 타이틀 (시중: / 내정: / 최저:) 및 가격 -->
            <TextBlock Margin="2,32,0,0" Foreground="lime" FontSize="13">
                <Run Text="{Binding CowInfo.LowestPriceTitleShort, FallbackValue='내정:'}"/>
                <Run Text="{Binding CowInfo.LowestPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="Yellow"/>
            </TextBlock>

            <!-- 4행: 중량 및 임신 -->
            <TextBlock Margin="2,48,0,0" Foreground="lime" FontSize="13">
                <Run Text="중량: "/>
                <Run Text="{Binding CowInfo.Weight, Converter={StaticResource NumberFormatConverter}}" Foreground="Yellow"/>
            </TextBlock>
            <Canvas Margin="68,48,0,0">
                <TextBlock Foreground="lime" FontSize="13">
                    <Run Text="임신: "/>
                    <Run Text="{Binding CowInfo.Pregnant, FallbackValue='-', TargetNullValue='-'}" Foreground="Red"/>
                </TextBlock>
            </Canvas>

            <!-- 5행: 생년월일 -->
            <TextBlock Text="{Binding CowInfo.Birth}" Foreground="Cyan" Margin="2,64,0,0" FontSize="13"/>

            <!-- 6행: 어미 / 계대 -->
            <TextBlock Margin="2,80,0,0" Foreground="lime" FontSize="13">
                <Run Text="어미: "/>
                <Run Text="{Binding CowInfo.MotherLevel, Converter={StaticResource MotherLevelConverter}}" Foreground="Orange"/>
            </TextBlock>
            <TextBlock Margin="68,80,0,0" Foreground="lime" FontSize="13">
                <Run Text="계대: "/>
                <Run Text="{Binding CowInfo.Blood}" Foreground="Orange"/>
            </TextBlock>

            <!-- 7행: KPN / 산차 -->
            <TextBlock Margin="2,96,0,0" Foreground="lime" FontSize="13">
                <Run Text="KPN: "/>
                <Run Text="{Binding CowInfo.KPN}" Foreground="Orange"/>
            </TextBlock>
            <TextBlock Margin="68,96,0,0" Foreground="lime" FontSize="13">
                <Run Text="산차: "/>
                <Run Text="{Binding CowInfo.CalvingNumber}" Foreground="Orange"/>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>