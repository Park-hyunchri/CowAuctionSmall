<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1.GochangBuanRun"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <!-- 구미칠곡축협 전용 러닝 페이지 -->
    <UserControl.Resources>
        <Style x:Key="BlinkingBorderStyle2" TargetType="Border">
            <Setter Property="BorderBrush" Value="black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.BorderBrush)" Duration="0:0:1">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="Black"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="#FD3A4A"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:PregnancyValueConverter x:Key="PregnancyValueConverter" />
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:BloodFontStyle x:Key="BloodFontStyle"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- 육종 등급 색상 (실버) -->
        <Style x:Key="AbcdColorStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="Silver"/>
        </Style>
    </UserControl.Resources>

    <Border BorderThickness="2" Style="{StaticResource BlinkingBorderStyle2}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid>
            <!-- 우측 성별 (암/수) -->
            <TextBlock Text="{Binding CowInfo.Sex}" Style="{Binding CowInfo, Converter={StaticResource CowTypeToStyleConverter_V3}}" VerticalAlignment="Top" x:Name="Sex">
                <TextBlock.RenderTransform>
                    <TranslateTransform Y="17"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- 1행: 축종 / 등록구분 / 개체관리번호 -->
            <TextBlock Panel.ZIndex="100" Margin="0,0,0,0" Text="{Binding CowInfo.StrCowDistinction}" Style="{Binding CowInfo.StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction"/>
            <TextBlock Panel.ZIndex="50" Margin="37,0,0,0" Text="{Binding CowInfo.RegistrationCategory, Converter={StaticResource MotherLevelConverter}}" Style="{Binding CowInfo.RegistrationCategory, Converter={StaticResource BloodFontStyle}}"/>
            <TextBlock Panel.ZIndex="100" Margin="60,0,0,108" Text="{Binding CowInfo.EntityNumber}" Foreground="{DynamicResource EntityNumberForeground}" />
            <TextBlock Panel.ZIndex="150" Margin="80,0,0,110" Width="30" Text="{Binding CowInfo.EntityNumberShort}" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" />

            <!-- 2행: 출하지역 / 농가명 -->
            <TextBlock Margin="2,16,0,0" Foreground="magenta">
                <Run Text="{Binding CowInfo.Location}"/>
                <Run Text=" "/>
                <Run Text="{Binding CowInfo.OwnerName}" Foreground="Cyan"/>
            </TextBlock>

            <!-- 3행: 최저가 -->
            <TextBlock Margin="2,32,0,0" Foreground="lime">
                <Run Text="최저 : "/>
                <Run Text="{Binding CowInfo.LowestPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="Yellow"/>
            </TextBlock>

            <!-- 4행: 육종 정보 (BABA 실버 표출) -->
            <StackPanel Orientation="Horizontal" Margin="2,47,0,0">
                <TextBlock Text="육종 :" Foreground="lime"/>
                <TextBlock Text="{Binding CowInfo.bodyWeightInColdString}" Style="{StaticResource AbcdColorStyle}" Margin="2,0,0,0"/>
                <TextBlock Text="{Binding CowInfo.longestMuscleCrossSectionString}" Style="{StaticResource AbcdColorStyle}"/>
                <TextBlock Text="{Binding CowInfo.fatThicknessOnBackString}" Style="{StaticResource AbcdColorStyle}"/>
                <TextBlock Text="{Binding CowInfo.intramuscularFatContentString}" Style="{StaticResource AbcdColorStyle}"/>
            </StackPanel>

            <!-- 5행: 생년월일 / 개월수 -->
            <TextBlock Text="{Binding CowInfo.Birth}" Foreground="Cyan" Margin="2,62,0,0"/>

            <!-- 6행: 중량 / 계대 (우측 정렬 라인 X=75) -->
            <TextBlock Margin="2,76,50,0" Foreground="lime">
                <Run Text="중량 : "/>
                <Run Text="{Binding CowInfo.Weight}" Foreground="Yellow"/>
            </TextBlock>
            <TextBlock Margin="75,76,0,30" Foreground="lime">
                <Run Text="계대 : "/>
                <Run Text="{Binding CowInfo.Blood}" Foreground="Orange"/>
            </TextBlock>

            <!-- 7행: KPN / 산차 (우측 정렬 라인 X=75) -->
            <TextBlock Margin="2,92,50,0" Foreground="lime">
                <Run Text="KPN : "/>
                <Run Text="{Binding CowInfo.KPN}" Foreground="Orange"/>
            </TextBlock>
            <TextBlock Margin="75,92,0,0" Foreground="lime">
                <Run Text="산차 : "/>
                <Run Text="{Binding CowInfo.CalvingNumber}" Foreground="Orange"/>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>