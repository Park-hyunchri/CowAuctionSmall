<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.StandardQQuri_Run1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.Running"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             xmlns:comon="clr-namespace:CowAuctionSmall.Views.Common"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128"
             UseLayoutRounding="True">
    <!-- 뿌리농가(IsShowQQuri = Y) 러닝 페이지 -->
    <UserControl.Resources>
        <Style x:Key="BlinkingBorderStyle2" TargetType="Border">
            <Setter Property="BorderBrush" Value="black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames
                                    Storyboard.TargetProperty="(Border.BorderBrush)"
                                    Duration="0:0:1">
                                    <!-- 검정색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="Black"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>

                                    <!-- 빨간색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="#FD3A4A"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 추가 -->
        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:PregnancyValueConverter  x:Key="PregnancyValueConverter" />
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:BloodFontStyle x:Key="BloodFontStyle"/>
        <models:NhLabelConverter x:Key="NhLabelConverter"/>
        <models:NH_EPD_ShowToVisibilityConverter x:Key="NH_EPD_ShowToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <!-- 흐릿한 윤곽 대신 일반적인 ClearType 사용 -->
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <!-- 확대/축소에도 글자 힌팅을 고정 -->
            <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="RoundBoarder" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
        </Style>

        <Style x:Key="AbcdColorStyle" TargetType="TextBlock">
            <!-- 기본 설정: 밝게 + 굵게 -->
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="Silver"/>

            <Style.Triggers>
                <!-- A: 파랑 계열 → 아주 밝은 하늘색 -->
                <Trigger Property="Text" Value="A">
                    <Setter Property="Foreground" Value="#00BFFF"/>
                    <!-- DeepSkyBlue -->
                </Trigger>

                <!-- B: 초록 계열 → 형광 초록에 가깝게 -->
                <Trigger Property="Text" Value="B">
                    <Setter Property="Foreground" Value="#00FF00"/>
                    <!-- Lime -->
                </Trigger>

                <!-- C: 주황 계열 → 더 밝은 주황/노랑 사이 -->
                <Trigger Property="Text" Value="C">
                    <Setter Property="Foreground" Value="#FFA500"/>
                    <!-- Orange -->
                </Trigger>

                <!-- D: 빨강 계열 → 아주 진한 빨강 -->
                <Trigger Property="Text" Value="D">
                    <Setter Property="Foreground" Value="#FF0000"/>
                    <!-- Red -->
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 1번 능력 -->
        <Style x:Key="NhAbility1Style" TargetType="TextBlock" BasedOn="{StaticResource AbcdColorStyle}">
            <!-- 기본: CowDistinction != 3 일 때 -->
            <Setter Property="Margin" Value="60,0,0,0"/>
            <Style.Triggers>
                <!-- CowDistinction == 3 이면 왼쪽으로 당기기 -->
                <DataTrigger Binding="{Binding CowInfo.CowDistinction}" Value="3">
                    <Setter Property="Margin" Value="30,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 2번 능력 -->
        <Style x:Key="NhAbility2Style" TargetType="TextBlock" BasedOn="{StaticResource AbcdColorStyle}">
            <Setter Property="Margin" Value="70,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CowInfo.CowDistinction}" Value="3">
                    <Setter Property="Margin" Value="40,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 3번 능력 -->
        <Style x:Key="NhAbility3Style" TargetType="TextBlock" BasedOn="{StaticResource AbcdColorStyle}">
            <Setter Property="Margin" Value="80,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CowInfo.CowDistinction}" Value="3">
                    <Setter Property="Margin" Value="50,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 4번 능력 -->
        <Style x:Key="NhAbility4Style" TargetType="TextBlock" BasedOn="{StaticResource AbcdColorStyle}">
            <Setter Property="Margin" Value="90,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CowInfo.CowDistinction}" Value="3">
                    <Setter Property="Margin" Value="60,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Border BorderThickness="2" Style="{StaticResource BlinkingBorderStyle2}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid>
            <Grid>

                <TextBlock Text="{Binding CowInfo.Sex}" Style="{Binding CowInfo, Converter={StaticResource CowTypeToStyleConverter_V3}}" VerticalAlignment="Top" x:Name="Sex" >
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="10"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
                <TextBlock Margin="0,0,0,110" Text="{Binding CowInfo.StrCowDistinction}"   Style="{Binding CowInfo.StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction" Panel.ZIndex="100"/>

                <TextBlock Margin="37,0,0,110" Text="{Binding CowInfo.RegistrationCategory, Converter={StaticResource MotherLevelConverter}}" Style="{Binding CowInfo.RegistrationCategory, Converter={StaticResource BloodFontStyle}}" Panel.ZIndex="100"/>
                <TextBlock Margin="60,0,0,110" Text="{Binding CowInfo.EntityNumber}"  Foreground="{DynamicResource EntityNumberForeground}" Panel.ZIndex="99"/>
                <TextBlock Margin="80,0,0,110" Text="{Binding CowInfo.EntityNumberShort}"  Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" Panel.ZIndex="100" Width="30"/>
                <!-- ======================================================================================================================================================================= -->

                <!-- 새로 -->
                <comon:NhQquriBadge Canvas.Left="0" Canvas.Top="0" />

                <TextBlock Margin="0,26,0,0" Foreground="lime" FontSize="11">
                    <Run Text="{Binding CowInfo.Location}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding CowInfo.OwnerName}" Foreground="Cyan"/>
                </TextBlock>

                <TextBlock Margin="0,39,0,0" Foreground="lime">
                    <Run Text="최저 :"/>
                    <Run Text="{Binding CowInfo.LowestPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="Yellow"/>
                </TextBlock>

                <TextBlock Margin="78,40,3,70" Text="{Binding CowInfo.Is_strＮh_Excellent}" FontSize="11" Foreground="Red" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Aliased" />

                <!-- ======================================================================================================================================================================= -->
                <Canvas Margin="70,53,0,0" >
                    <Canvas.Style>
                        <Style TargetType="Canvas">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CowInfo.Pregnant, Converter={StaticResource PregnancyValueConverter}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Canvas.Style>
                    <TextBlock Margin="2,0,0,0" Foreground="lime">
                        <Run Text="임신 : "/>
                        <Run Text="{Binding CowInfo.Pregnant}" Foreground="Yellow"/>
                    </TextBlock>
                </Canvas>

                <!-- ======================================================================================================================================================================= -->
                <!-- Nh_ability_1_str 값이 있을 때 -->
                <Canvas Margin="0,53,0,0" Visibility="{Binding CowInfo.Nh_ability_1_str, Converter={StaticResource NH_EPD_ShowToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="#FF0064" Text="{Binding CowInfo.CowDistinction, Converter={StaticResource NhLabelConverter}}"/>
                        <TextBlock Text="{Binding CowInfo.Nh_ability_1_str}" Style="{StaticResource AbcdColorStyle}" Margin="1,0,0,0"/>
                        <TextBlock Text="{Binding CowInfo.Nh_ability_2_str}" Style="{StaticResource AbcdColorStyle}" Margin="1,0,0,0"/>
                        <TextBlock Text="{Binding CowInfo.Nh_ability_3_str}" Style="{StaticResource AbcdColorStyle}" Margin="1,0,0,0"/>
                        <TextBlock Text="{Binding CowInfo.Nh_ability_4_str}" Style="{StaticResource AbcdColorStyle}" Margin="1,0,0,0"/>
                    </StackPanel>
                </Canvas>

                <!-- Nh_ability_1_str 값이 없을 때 -->
                <Canvas Margin="-2,53,0,0" Visibility="{Binding CowInfo.Nh_ability_1_str, Converter={StaticResource NH_EPD_ShowToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                        <TextBlock Foreground="lime" Text="육종:"/>
                        <TextBlock Text="{Binding CowInfo.bodyWeightInColdString}" Style="{StaticResource AbcdColorStyle}" Foreground="Yellow"  Margin="1,0,0,0"/>
                        <TextBlock Text="{Binding CowInfo.longestMuscleCrossSectionString}" Style="{StaticResource AbcdColorStyle}" Foreground="Yellow"  Margin="1,0,0,0"/>
                        <TextBlock Text="{Binding CowInfo.fatThicknessOnBackString}" Style="{StaticResource AbcdColorStyle}" Foreground="Yellow"  Margin="1,0,0,0"/>
                        <TextBlock Text="{Binding CowInfo.intramuscularFatContentString}" Style="{StaticResource AbcdColorStyle}" Foreground="Yellow"  Margin="1,0,0,0"/>
                    </StackPanel>
                </Canvas>

                <!-- ======================================================================================================================================================================= -->

                <!-- 생년월일 -->
                <TextBlock Text="{Binding CowInfo.Birth}" Foreground="Cyan" Margin="2,67,0,43"/>

                <!-- ======================================================================================================================================================================= -->
                <TextBlock Margin="2,81,50,0" Foreground="lime">
                    <Run Text="중량 :"/>
                    <Run Text="{Binding CowInfo.Weight}" Foreground="Yellow"/>
                </TextBlock>

                <TextBlock Margin="75,81,0,30" Foreground="lime">
                    <Run Text="계대 :"/>
                    <Run Text="{Binding CowInfo.Blood}" Foreground="Orange"/>
                </TextBlock>

                <TextBlock Margin="2,95,50,0" Foreground="lime">
                    <Run Text="KPN :"/>
                    <Run Text="{Binding CowInfo.KPN}" Foreground="Orange"/>
                </TextBlock>

                <TextBlock Margin="75,95,0,0" Foreground="lime">
                    <Run Text="산차 :"/>
                    <Run Text="{Binding CowInfo.CalvingNumber}" Foreground="Orange"/>
                </TextBlock>

            </Grid>
</Grid>
    </Border>

</UserControl>
