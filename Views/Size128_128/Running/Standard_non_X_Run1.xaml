<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.Standard_non_X_Run1"
             xmlns:entity="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.Running"
             xmlns:models="clr-namespace:CowAuctionSmall.Presentation.Converters"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <!-- 뿌리농가(IsShowQQuri = X) 러닝 페이지 -->
    <UserControl.Resources>
        <Style x:Key="BlinkingBorderStyle2" TargetType="Border">
            <Setter Property="BorderBrush" Value="black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType={x:Type local:Standard_non_X_Run1}}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames
                                    Storyboard.TargetProperty="(Border.BorderBrush)"
                                    Duration="0:0:1">
                                    <!-- 검정색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="Black"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>

                                    <!-- 빨간색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="#FD3A4A"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 추가 -->
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:BloodFontStyle x:Key="BloodFontStyle"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="AbcdColorStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="Silver"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="A">
                    <Setter Property="Foreground" Value="Silver"/>
                </Trigger>
                <Trigger Property="Text" Value="B">
                    <Setter Property="Foreground" Value="Silver"/>
                </Trigger>
                <Trigger Property="Text" Value="C">
                    <Setter Property="Foreground" Value="Silver"/>
                </Trigger>
                <Trigger Property="Text" Value="D">
                    <Setter Property="Foreground" Value="Silver"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Border BorderThickness="2" Style="{StaticResource BlinkingBorderStyle2}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid DataContext="{Binding CowInfo}">
            <Grid>
                <TextBlock Style="{StaticResource SexTextV3}" DataContext="{Binding DataContext.ItemDisplay, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Standard_non_X_Run1}}}" VerticalAlignment="Top" x:Name="Sex">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="17"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- ======================================================================================================================================================================= -->
                <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
                <TextBlock Panel.ZIndex="100" Margin="0,0,0,0" Text="{Binding StrCowDistinction}"   Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction"/>
                <!-- 전체 개체관리번호 (users.xml 동적 색상 적용) -->
                <entity:EntityNumberText Panel.ZIndex="100" Margin="40,0,0,110" 
                                         Number="{Binding EntityNumber}"  
                                         Foreground="{DynamicResource EntityNumberForeground}" 
                                         HighlightForeground="{DynamicResource EntityNumberShortForeground}" 
                                         Style="{StaticResource {x:Type TextBlock}}" />
                <!-- 4자리 단축 번호 강조 박스 (users.xml 동적 색상 적용) -->
                <!-- ======================================================================================================================================================================= -->

                <!-- 출하지역 색상값 (users.xml 동적 색상 적용) -->
                <TextBlock Margin="2,16,0,0">
                    <Run Text="{Binding Location}" Foreground="{DynamicResource LocationForeground}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding OwnerName}" Foreground="Cyan"/>
                </TextBlock>

                <TextBlock Margin="2,32,0,77" Foreground="lime">
                    <Run Text="최저 :"/>
                    <Run Text="{Binding DataContext.ItemDisplay.LowestPriceText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Standard_non_X_Run1}}}" Foreground="Yellow"/>
                </TextBlock>

                <!-- ======================================================================================================================================================================= -->
                <TextBlock Margin="2,47,50,62" Foreground="lime">
                    <Run Text="중량 :"/>
                    <Run Text="{Binding DataContext.ItemDisplay.WeightText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Standard_non_X_Run1}}}" Foreground="Yellow"/>
                </TextBlock>
                <!-- ======================================================================================================================================================================= -->
                <Canvas Margin="70,47,0,0" >
                    <Canvas.Style>
                        <Style TargetType="Canvas">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.ItemDisplay.ShowPregnancy, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Standard_non_X_Run1}}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Canvas.Style>
                    <TextBlock Margin="5,0,0,0" Foreground="lime">
                        <Run Text="임신:"/>
                        <Run Text="{Binding Pregnant}" Foreground="Yellow"/>
                    </TextBlock>
                </Canvas>

                <!-- 생년월일 -->
                <TextBlock Text="{Binding Birth}" Foreground="Cyan" Margin="2,62,0,0"/>

                <!-- ======================================================================================================================================================================= -->

                <Canvas Margin="2,76,50,0">
                    <TextBlock Text="등록 :" Foreground="lime"/>
                    <TextBlock Text="{Binding RegistrationCategory, Converter={StaticResource MotherLevelConverter}}"
                               Style="{Binding RegistrationCategory, Converter={StaticResource BloodFontStyle}}"/>
                </Canvas>

                <TextBlock Margin="75,76,0,30" Foreground="lime">
                    <Run Text="계대 :"/>
                    <Run Text="{Binding Blood}" Foreground="Orange"/>
                </TextBlock>

                <TextBlock Margin="2,92,50,0" Foreground="lime">
                    <Run Text="KPN  "/>
                    <Run Text="{Binding KPN}" Foreground="Orange"/>
                </TextBlock>
                <TextBlock Margin="30,92,50,0" Text=":" Foreground="lime"/>

                <TextBlock Margin="75,92,0,0" Foreground="lime">
                    <Run Text="산차 :"/>
                    <Run Text="{Binding CalvingNumber}" Foreground="Orange"/>
                </TextBlock>

            </Grid>
        </Grid>
    </Border>

</UserControl>

