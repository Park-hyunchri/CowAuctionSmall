<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.RunningNoteHost128"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             x:Name="root"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d"
             d:DesignHeight="128" d:DesignWidth="128">
<!-- 친자일치 여부 및 비고 페이지 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <ContentPresenter Content="{Binding ElementName=root, Path=PageContent}"/>

        <Border x:Name="borderPaternityMatch"
                Margin="2,108,98,3"
                BorderBrush="Yellow"
                BorderThickness="1"
                CornerRadius="3"
                Padding="1"
                Panel.ZIndex="100"
                IsHitTestVisible="False"
                Visibility="{Binding HasPaternityMatch, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="Yellow" Text="{Binding CowInfo.PaternityMatch}"/>
        </Border>

        <Canvas x:Name="canvas" ClipToBounds="True" Margin="{Binding NoteMargin}" IsHitTestVisible="False" Panel.ZIndex="110">
            <TextBlock x:Name="note"
                       Text="{Binding Note}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Foreground="#f61c2d"
                       FontWeight="Regular"
                       FontSize="12"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       RenderTransformOrigin="0,0"/>
        </Canvas>
    </Grid>
</UserControl>
