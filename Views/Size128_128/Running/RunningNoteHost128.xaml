<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.RunningNoteHost128"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.Running"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             Width="128" Height="128" Background="Black">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- 1. 메인 페이지 레이아웃 (AnseongRun 등) -->
        <ContentControl Content="{Binding PageContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <!-- 2. 최하단 고정 영역 (친자 뱃지 + #f61c2d 비고 자막) -->
        <Canvas IsHitTestVisible="False">

            <!-- 친자 뱃지 (노란 테두리 / 노란 글씨 '친자') -->
            <Border x:Name="borderPaternityMatch"
                    Canvas.Left="2" Canvas.Top="108"
                    Width="28" Height="18"
                    BorderBrush="Yellow"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="1"
                    Panel.ZIndex="100"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasPaternityMatch, Converter={StaticResource BoolToVis}}">

                <TextBlock Text="친자" 
                           Foreground="Yellow" 
                           FontSize="11" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Border>

            <!-- 흘러가는 비고 텍스트 (색상: #f61c2d, 폰트크기: 12) -->
            <Canvas x:Name="canvasNote" 
                    Canvas.Top="110"
                    Width="124" Height="18" 
                    ClipToBounds="True">
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Canvas.Left" Value="2"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPaternityMatch}" Value="True">
                                <Setter Property="Canvas.Left" Value="32"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>

                <TextBlock x:Name="note" 
                           Text="{Binding Note}" 
                           Foreground="#f61c2d" 
                           FontSize="12" 
                           Margin="0,1,0,0"
                           Canvas.Left="0" Canvas.Top="0"/>
            </Canvas>

        </Canvas>
    </Grid>
</UserControl>