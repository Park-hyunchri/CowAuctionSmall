<UserControl x:Class="CowAuctionSmall.Views.Size128_128.CustomAUctionUnSold.AnseongUnSold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.CustomAUctionUnSold"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             Height="128" Width="128">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <models:NhLabelConverter x:Key="NhLabelConverter"/>
        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:WeightKGConverter x:Key="WeightKGConverter"/>
        <models:NH_EPD_ShowToVisibilityConverter x:Key="NH_EPD_ShowToVisibilityConverter"/>
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <models:SelectShowWeightEpdMultiConverter x:Key="SelectShowWeightEpdMultiConverter"/>
    </UserControl.Resources>

    <Grid Background="black">
        <Border BorderThickness="2" BorderBrush="OrangeRed"/>
        <Grid>
            <!-- 1. "유    찰" 상단 타이틀 -->
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Text="유    찰" FontSize="24" Foreground="#e5081b" FontWeight="Bold" Margin="0,1,0,0"/>

            <!-- 2. 우측 상단 성별/구분 (미경/암/수 등 폰트 20 적용하여 숫자 가림 방지) -->
            <Canvas Margin="2,30,0,0">
                <TextBlock Text="{Binding Sex}" Style="{Binding CopyGValues, Converter={StaticResource CowTypeToStyleConverter_V3}}" VerticalAlignment="Top" x:Name="Sex"/>
            </Canvas>
            
            <!-- 3. 최저가 -->
            <TextBlock Margin="2,25,0,0" FontSize="13">
                <Run Text="최저 : " Foreground="lime"/>
                <Run Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="Yellow"/>
            </TextBlock>

            <!-- 4. 중량 -->
            <TextBlock Margin="2,41,0,0" FontSize="13">
                <Run Text="중량 : " Foreground="lime"/>
                <Run Text="{Binding Weight}" Foreground="Yellow"/>
            </TextBlock>

            <!-- 5. 육종 정보 (밝은 실버색 적용) -->
            <StackPanel Orientation="Horizontal" Margin="2,57,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="육종 :" Foreground="lime" FontSize="13"/>
                <TextBlock Text="{Binding bodyWeightInColdString}" Foreground="Silver" FontSize="13" Margin="2,0,0,0" FontWeight="Bold"/>
                <TextBlock Text="{Binding longestMuscleCrossSectionString}" Foreground="Silver" FontSize="13" FontWeight="Bold"/>
                <TextBlock Text="{Binding fatThicknessOnBackString}" Foreground="Silver" FontSize="13" FontWeight="Bold"/>
                <TextBlock Text="{Binding intramuscularFatContentString}" Foreground="Silver" FontSize="13" FontWeight="Bold"/>
            </StackPanel>

            <!-- 6. 품목 구분 및 개체번호(번식우, 송아지 등) -->
            <TextBlock Text="{Binding StrCowDistinction}" Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction" FontSize="13" FontWeight="Normal" VerticalAlignment="Center" Margin="2,33,2,0"/>

            <!-- 개체번호 (전체 및 뒷자리 주황색 강조) -->
            <Grid VerticalAlignment="Center" Margin="45,33,2,0">
                <TextBlock Text="{Binding EntityNumber}" Foreground="Silver" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" 
               Text="{Binding EntityNumberShort}" 
               HorizontalAlignment="Center" VerticalAlignment="Center" 
               Foreground="{DynamicResource EntityNumberShortForeground}" 
               Background="Black" 
               Margin="12,0,0,0" FontSize="13" FontWeight="Normal" />
            </Grid>

            <!-- 7. 생년월일 / 개월수 -->
            <TextBlock Margin="2,89,0,0" Text="{Binding Birth}" Foreground="Cyan" FontSize="12"/>
        </Grid>

    </Grid>
</UserControl>