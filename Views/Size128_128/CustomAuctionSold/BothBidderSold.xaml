<UserControl x:Class="CowAuctionSmall.Views.Size128_128.CustomAuctionSold.BothBidderSold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.CustomAuctionSold"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             FontWeight="Bold"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:BidderLeftPositionConverter x:Key="BidderLeftPositionConverter"/>
    </UserControl.Resources>

    <Border BorderBrush="Blue" BorderThickness="2">

        <Grid Background="Black">
            <TextBlock Visibility="Collapsed" Text="{Binding CowDistinction}" />
            <!-- "낙찰"을 표시하는 TextBlock -->
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Text="낙    찰" FontSize="23" Foreground="Violet" />

            <Canvas Margin="0,22,0,0">
                <TextBlock Text="최저가 : "  Foreground="lime"  Margin="2,0,0,0" FontSize="13"/>
                <TextBlock Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}}" Margin="60,0,0,0" Foreground="#FFA500" FontSize="13"/>
            </Canvas>

            <Canvas Margin="0,37,0,0">
                <TextBlock Text="낙찰가 : "  Foreground="lime"  Margin="2,0,0,0" FontSize="13"/>
                <TextBlock Text="{Binding BidPrice, Converter={StaticResource NumberFormatConverter}}" Margin="60,0,0,0" Foreground="Yellow" FontSize="13"/>
                <!--#87CEEB -->
            </Canvas>

            <Canvas Margin="0,52,0,0" >
                <TextBlock Text="낙찰자 : "  Foreground="Violet"  Margin="2,0,0,0" FontSize="13"/>
                <Canvas x:Name="canvasBidder" ClipToBounds="True" Height="15" HorizontalAlignment="Left" Canvas.Left="60" VerticalAlignment="Center" Width="64">
                    <TextBlock x:Name="bidder" Text="{Binding BidderNum}"  Foreground="Silver" FontSize="13"/>
                    <!--#FF69B4 -->
                </Canvas>
            </Canvas>


            <Canvas Margin="0,65,0,0">
                <!-- Canvas.Left 계산 -->
                <Canvas x:Name="canvasBidder2" ClipToBounds="True" Height="15" VerticalAlignment="Center" HorizontalAlignment="Left">
        
                    <!-- Width는 TextBlock 길이에 맞춰 자동 확장 -->
                    <Canvas.Width>
                        <Binding ElementName="bidder2" Path="ActualWidth" />
                    </Canvas.Width>

                    <!-- Canvas.Left 계산 -->
                    <Canvas.Left>
                        <MultiBinding Converter="{StaticResource BidderLeftPositionConverter}">
                            <Binding Path="BidderString"/>
                            <Binding ElementName="bidder2" Path="ActualWidth"/>
                        </MultiBinding>
                    </Canvas.Left>

                    <TextBlock x:Name="bidder2" Text="{Binding BidderString}" Foreground="Silver" FontSize="13" />
                </Canvas>
            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
            <Canvas Margin="0,80,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="개체 : "  Foreground="lime" Margin="2,0,0,0" />
                <TextBlock Text="{Binding EntityNumber}" Margin="40,0,0,0" Foreground="{DynamicResource EntityNumberForeground}"/>
                <TextBlock Text="{Binding EntityNumberShort}" Margin="73,0,0,0" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}"/>
            </Canvas>
            <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas -->
            <Canvas Margin="0,80,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
                <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0" />
                <TextBlock Text="{Binding SipNumber}" Margin="40,0,0,0" Foreground="Silver" Background="Black" FontWeight="Bold"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->

            <Canvas Margin="0,94,0,0">
                <TextBlock Text="{Binding Location}"  Foreground="{DynamicResource LocationForeground}" Margin="2,0,0,0" />
                <TextBlock Text="{Binding OwnerName}" Margin="28,0,0,0" Foreground="Cyan"/>
            </Canvas>

            <!-- Note를 표시하는 TextBlock -->
            
        </Grid>
    </Border>
</UserControl>