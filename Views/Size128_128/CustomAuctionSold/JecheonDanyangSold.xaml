<UserControl x:Class="CowAuctionSmall.Views.Size128_128.CustomAuctionSold.JecheonDanyangSold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.CustomAuctionSold"
                          xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <!-- 제천단양,보령축협 낙찰페이지 적용 -->
    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <models:CowTypeToStyleConverter_V2 x:Key="CowTypeToStyleConverter"/>
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <models:CowTypeToStyleConverter_V2 x:Key="CowTypeToStyleConverter_V2"/>
    </UserControl.Resources>

    <Border BorderBrush="#1E90FF" BorderThickness="2">

        <Grid Background="Black">

            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="18"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" HorizontalAlignment="Center" VerticalAlignment="Top" Text="낙    찰" FontSize="18" Foreground="Violet" FontWeight="Bold"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center"  Text="{Binding StrCowDistinction}"   Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction" FontSize="11" Margin="0,-2,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding EntityNumber}" Margin="0,0,0,0" VerticalAlignment="Center"  Foreground="{DynamicResource EntityNumberForeground}" FontSize="12" />
            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding EntityNumberShort}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource EntityNumberShortForeground}" Margin="5,0,0,0"  Background="{DynamicResource EntityNumberShortBackground}" FontSize="12" FontWeight="Bold" />

            <TextBlock  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Grid.RowSpan="2" Text="{Binding Sex}" Style="{Binding CopyGValues, Converter={StaticResource CowTypeToStyleConverter_V2}}" VerticalAlignment="Top" x:Name="Sex"/>
            <TextBlock  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" FontSize="12">
                <Run Text="{Binding Location}" Foreground="lime"/>
                <Run Text="{Binding OwnerName}" Foreground="Cyan"/>
            </TextBlock>

            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="최저가 :"  Foreground="lime" FontSize="12"/>
            <TextBlock  Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="Cyan" FontSize="12"/>

            <!-- 낙찰가 : 라벨 -->
            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="낙찰가 :"  Foreground="WhiteSmoke" FontSize="13" />

            <!-- 낙찰가 : 값 -->
            <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding BidPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="WhiteSmoke" VerticalAlignment="Center" FontSize="14" Margin="10,0,0,0"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="낙찰자" Foreground="Violet" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text=":" Foreground="Violet" FontSize="12" Margin="41,0,0,0" VerticalAlignment="Center"/>

            <Grid Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="3"  VerticalAlignment="Center" Margin="12,0,0,0">

                <!-- N : 숫자만 (현재와 동일한 형태) -->
                <TextBlock x:Name="tbBidderNumberOnly" Text="{Binding Bidder}" Foreground="Yellow" FontSize="23" FontWeight="Bold"  VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BidderName}" Value="N">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Y : 사람 이름만 (2줄/줄바꿈) -->
                <TextBlock x:Name="tbBidderNameOnly" Text="{Binding Bidder}" Foreground="Yellow" TextWrapping="Wrap" TextAlignment="Center"  VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Style.Triggers>
                                <!-- 1) Y일 때만 보이게 -->
                                <DataTrigger Binding="{Binding BidderName}" Value="Y">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>

                                <!-- 2) 2줄짜리 이름이면 폰트 14 -->
                                <DataTrigger Binding="{Binding IsTwoLineName}" Value="True">
                                    <Setter Property="FontSize" Value="14"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>


                <!-- B : 윗줄 숫자, 아랫줄 이름 -->
                <StackPanel x:Name="spBidderNumberAndName" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BidderName}" Value="B">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- 윗줄 : 숫자 -->
                    <TextBlock  Foreground="Yellow" FontSize="16"  TextAlignment="Left" FontWeight="Bold" >
                        <Run Text="{Binding BidderNum}" />
                    </TextBlock>

                    <!-- 아랫줄 : 이름 (2줄 허용) -->
                    <TextBlock Text="{Binding BidderString}" Foreground="Yellow" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="80" TextWrapping="NoWrap" FontSize="11" />

                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</UserControl>
