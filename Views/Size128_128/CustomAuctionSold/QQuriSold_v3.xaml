<UserControl x:Class="CowAuctionSmall.Views.Size128_128.CustomAuctionSold.QQuriSold_v3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.CustomAuctionSold"
                          xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">

    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border BorderBrush="#1E90FF" BorderThickness="2">

        <Grid Background="Black">

            <Grid.RowDefinitions>
                <RowDefinition Height="23"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.2*"/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" HorizontalAlignment="Center" VerticalAlignment="Top" Text="낙    찰" FontSize="22" Foreground="Violet" FontWeight="Bold"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="최저가 :"  Foreground="lime" FontSize="13"  VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock  Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="Orange" FontSize="15" VerticalAlignment="Center" Margin="7,0,0,0" HorizontalAlignment="Left"  FontWeight="Bold"/>
            
            <!-- 낙찰가 : 라벨 -->
            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="낙찰가 :"  Foreground="lime" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <!-- 낙찰가 : 값 -->
            <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding BidPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="Yellow" FontSize="15" VerticalAlignment="Center" Margin="7,0,0,0" HorizontalAlignment="Left"  FontWeight="Bold"/>

            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal"  VerticalAlignment="Center" Margin="0,3,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <!-- 기본은 안 보이게 -->
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <!-- CowDistinction 이 2일 때 보이게 -->
                            <DataTrigger Binding="{Binding CowDistinction}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!-- CowDistinction 이 3일 때 보이게 -->
                            <DataTrigger Binding="{Binding CowDistinction}" Value="3">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!-- CowDistinction 이 5일 때 보이게 -->
                            <DataTrigger Binding="{Binding CowDistinction}" Value="5">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="중량" Foreground="lime" FontSize="12" Margin="6,0,0,0"/>
                <TextBlock Text=":" Foreground="lime" FontSize="12" Margin="11,0,0,0"/>
                <TextBlock Foreground="Cyan" FontSize="12" Margin="7,0,0,0">
                    <Run Text="{Binding Weight, Converter={StaticResource NumberFormatConverter}}" Foreground="Orange"/>
                    <Run Text=" kg" Foreground="Orange"/>
                </TextBlock>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2" Text="낙찰자 :" Foreground="Violet" FontSize="13" VerticalAlignment="Center"/>
 
            <Grid Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3" Grid.RowSpan="3" VerticalAlignment="Center">

                <!-- B : 윗줄 숫자, 아랫줄 이름 -->
                <StackPanel x:Name="spBidderNumberAndName" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- 윗줄 : 숫자 -->
                    <TextBlock  Foreground="WhiteSmoke">
                        <Run Text="{Binding BidderString}" FontWeight="Bold"/>
                    </TextBlock> 

                    <!-- 아랫줄 : 이름 (2줄 허용) -->
                    <TextBlock  Foreground="WhiteSmoke" FontWeight="Bold">
                        <Run Text="(" />
                        <Run Text="{Binding BidderNum}" />
                        <Run Text=")" />
                    </TextBlock>

                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"  Text="{Binding StrCowDistinction}"   Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction" FontSize="15" Margin="-2,-2,0,0"/>
            <TextBlock Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding EntityNumber}" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{DynamicResource EntityNumberForeground}" FontSize="13"/>
            <TextBlock Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding EntityNumberShort}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource EntityNumberShortForeground}" Margin="20,0,0,0"  Background="{DynamicResource EntityNumberShortBackground}" FontSize="13" FontWeight="Bold" />

        </Grid>
    </Border>
</UserControl>
