<UserControl x:Class="CowAuctionSmall.Views.Size128_128.CustomAuctionSold.HwasunSold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.CustomAuctionSold"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             FontWeight="Bold"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <!-- 화순축협 낙찰페이지 적용 -->
    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        
        <models:CowTypeToStyleConverter x:Key="CowTypeToStyleConverter"/>
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
    </UserControl.Resources>

    <Border BorderBrush="Blue" BorderThickness="2">

        <Grid Background="Black">
            <TextBlock Visibility="Collapsed" Text="{Binding CowDistinction}" />
            <!-- "낙찰"을 표시하는 TextBlock -->
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Text="낙    찰" FontSize="25" Foreground="Violet" />

            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <Canvas Margin="0,30,0,0">
                    <TextBlock Text="최저가 : "  Foreground="lime"  Margin="2,0,0,0" FontSize="13"/>
                    <TextBlock Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter} }" Margin="56,0,0,0" Foreground="#FFA500" FontSize="13"/>
                </Canvas>

                <Canvas Margin="0,45,0,0">
                    <TextBlock Text="낙찰가 : "  Foreground="lime"  Margin="2,0,0,0" FontSize="13"/>
                    <TextBlock Text="{Binding BidPrice, Converter={StaticResource NumberFormatConverter} }" Margin="56,0,0,0" Foreground="Yellow" FontSize="13"/>
                    <!--#87CEEB -->
                </Canvas>
            </Canvas>

            <Canvas Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
                <Canvas Margin="0,30,0,0">
                    <TextBlock Text="최저가 : "  Foreground="lime"  Margin="2,0,0,0" FontSize="13"/>
                    <TextBlock Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter} , StringFormat={}{0} 천원 }" Margin="56,0,0,0" Foreground="#FFA500" FontSize="13"/>
                </Canvas>

                <Canvas Margin="0,45,0,0">
                    <TextBlock Text="낙찰가 : "  Foreground="lime"  Margin="2,0,0,0" FontSize="13"/>
                    <TextBlock Text="{Binding BidPrice, Converter={StaticResource NumberFormatConverter} , StringFormat={}{0} 천원 }" Margin="56,0,0,0" Foreground="Yellow" FontSize="13"/>
                    <!--#87CEEB -->
                </Canvas>
            </Canvas>

            <Canvas Margin="0,60,0,0" >
                <TextBlock Text="낙찰자 : "  Foreground="Violet"  Margin="2,0,0,0" FontSize="13"/>
                <Canvas x:Name="canvasBidder" ClipToBounds="True" Height="30" HorizontalAlignment="Center" Canvas.Left="56" VerticalAlignment="Center" Width="65">
                    <TextBlock x:Name="bidder" Text="{Binding BidderString}"  Foreground="Silver" FontSize="13"/>
                    <TextBlock x:Name="bidder2" Text="{Binding BidderNum , StringFormat={} ( {0} )}"    Foreground="Silver" FontSize="13" HorizontalAlignment="Center" Canvas.Top="15" VerticalAlignment="Top" />
                    <!--#FF69B4 -->
                </Canvas>
            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
            <Canvas Margin="0,90,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="개체 : "  Foreground="lime" Margin="2,0,0,0" />
                <TextBlock Text="{Binding EntityNumber}" Margin="40,0,0,0" Foreground="{DynamicResource EntityNumberForeground}"/>
                <TextBlock Text="{Binding EntityNumberShort}" Margin="73,0,0,0" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}"/>
            </Canvas>
            <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas -->
            <Canvas Margin="0,90,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
                <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0" />
                <TextBlock Text="{Binding EntityNumberShort}" Margin="40,0,0,0" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" FontWeight="Bold"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->
            <!--
                <Canvas Margin="0,90,0,0">
                    <TextBlock Text="{Binding Location}"  Foreground="magenta" Margin="2,0,0,0" />
                    <TextBlock Text="{Binding OwnerName}" Margin="28,0,0,0" Foreground="Cyan"/>
                </Canvas>
            -->
            <!-- Note를 표시하는 TextBlock -->
            <Canvas x:Name="canvas" ClipToBounds="True" Margin="2,109,2,1">
                <TextBlock x:Name="note" Text="{Binding Note}" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Red" FontWeight="Regular" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" RenderTransformOrigin="0,0"/>
            </Canvas>
        </Grid>
    </Border>
</UserControl>

