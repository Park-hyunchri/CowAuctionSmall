<UserControl x:Class="CowAuctionSmall.Views.Size128_128.CustomAuctionSold.YangpyeongSold"
             xmlns:entity="clr-namespace:CowAuctionSmall.Views.Common"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.CustomAuctionSold"
             xmlns:models="clr-namespace:CowAuctionSmall.Presentation.Converters"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    
    <!-- 양평축협 낙찰페이지 적용 -->
    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
    </UserControl.Resources>

    <Border DataContext="{Binding Snapshot}" BorderBrush="#1E90FF" BorderThickness="2">

        <Grid Background="Black">
            <!-- 1. 상단 타이틀: "낙    찰" -->
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Text="낙    찰" FontSize="24" Foreground="Violet" FontWeight="Bold" Margin="0,1,0,0"/>
            
            <!-- 2. 출하주 -->
            <Canvas Margin="0,30,0,0">
                <TextBlock Text="출하주 : " Foreground="lime" Margin="2,0,0,0" FontSize="13"/>
                <TextBlock Text="{Binding OwnerName}" Margin="60,0,0,0" Foreground="White" FontSize="13"/>
            </Canvas>

            <!-- 3. 최저가 -->
            <Canvas Margin="0,45,0,0">
                <TextBlock Text="최저가 : "  Foreground="lime"  Margin="2,0,0,0" FontSize="13"/>
                <TextBlock Text="{Binding DataContext.LowestPriceText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:YangpyeongSold}}}" Margin="60,0,0,0" Foreground="#FFA500" FontSize="13"/>
            </Canvas>

            <!-- 4. 낙찰가 -->
            <Canvas Margin="0,60,0,0">
                <TextBlock Text="낙찰가 : "  Foreground="lime"  Margin="2,0,0,0" FontSize="13"/>
                <TextBlock Text="{Binding DataContext.BidPriceText, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:YangpyeongSold}}}" Margin="60,0,0,0" Foreground="Yellow" FontSize="13"/>
                <!--#87CEEB -->
            </Canvas>

            <!-- 5. 낙찰자 -->
            <Canvas Margin="0,75,0,0" >
                <TextBlock Text="낙찰자 : " Foreground="Violet" Margin="2,0,0,0" FontSize="13"/>
                <TextBlock Text="{Binding Bidder}" Margin="60,0,0,0" Foreground="Cyan" FontSize="13"/>
            </Canvas>

            <!-- 6. 축종 및 개체번호 (소/염소 구분) -->
            <Canvas Margin="0,90,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="{Binding StrCowDistinction}" Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" FontSize="13" Margin="2,0,0,0" x:Name="StrCowDistinction"/>
                <entity:EntityNumberText Number="{Binding EntityNumber}" Margin="45,0,0,0" Foreground="{DynamicResource EntityNumberForeground}" FontSize="13" HighlightForeground="{DynamicResource EntityNumberShortForeground}" Style="{StaticResource {x:Type TextBlock}}" />
            </Canvas>
            <Canvas Margin="0,90,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
                <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0" FontSize="13"/>
                <TextBlock Text="{Binding SipNumber}" Margin="44,0,0,0" Foreground="Silver" Background="Black" FontWeight="Bold" FontSize="13"/>
            </Canvas>
            
        </Grid>
    </Border>
</UserControl>
