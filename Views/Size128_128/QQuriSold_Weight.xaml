<UserControl x:Class="CowAuctionSmall.Views.Size128_128.QQuriSold_Weight"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128"
                          xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">

    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>

        </Style>

        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border BorderBrush="#1E90FF" BorderThickness="2">

        <Grid Background="Black">

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Text="낙    찰" FontSize="22" Foreground="Violet" FontWeight="Bold"/>

            <TextBlock Text="{Binding StrCowDistinction}"   Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction" FontSize="13" Margin="2,22,0,0"/>
            <TextBlock Text="{Binding EntityNumber}" Foreground="{DynamicResource EntityNumberForeground}" FontSize="13" Margin="43,22,0,0"/>
            <TextBlock Text="{Binding EntityNumberShort}" Foreground="{DynamicResource EntityNumberShortForeground}" Margin="73,22,16,80"  Background="{DynamicResource EntityNumberShortBackground}" FontSize="13" FontWeight="Bold" />

            <TextBlock  Text="최저가 :"  Foreground="lime" FontSize="13"  Margin="2,36,0,0" />
            <TextBlock  Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="Cyan" Margin="60,36,0,0"  FontSize="13" />


            <!-- 낙찰가 : 라벨 -->
            <TextBlock Text="낙찰가 :"  Foreground="WhiteSmoke" FontSize="13" Margin="2,52,0,0"/>
            <!-- 낙찰가 : 값 -->
            <TextBlock  Text="{Binding BidPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="WhiteSmoke" Margin="60,52,0,0" FontSize="13"/>

            <StackPanel Orientation="Horizontal" Margin="2,67,0,0">
                <TextBlock Text="중량" Foreground="lime" FontSize="13" Margin="4,0,0,0"/>
                <TextBlock Text=":" Foreground="lime" FontSize="13" Margin="13,0,0,0"/>
                <TextBlock Foreground="Cyan" FontSize="13" Margin="7,0,0,0">
                    <Run Text="{Binding Weight, Converter={StaticResource NumberFormatConverter}}" Foreground="Orange"/>
                    <Run Text=" kg" Foreground="Orange"/>
                </TextBlock>
            </StackPanel>


            <TextBlock Text="낙찰자" Foreground="Violet" FontSize="13" Margin="2,87,0,0"/>
            <TextBlock Text=":" Foreground="Violet" FontSize="13" Margin="45,87,0,0"/>

            <Grid Margin="35,65,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="8*"/>
                    <RowDefinition Height="51*"/>
                </Grid.RowDefinitions>

                <!-- N : 숫자만 (현재와 동일한 형태) -->
                <TextBlock x:Name="tbBidderNumberOnly" Text="{Binding Bidder}" Foreground="Yellow" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0" Grid.Row="1">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BidderName}" Value="N">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Y : 사람 이름만 (2줄/줄바꿈) -->
                <TextBlock x:Name="tbBidderNameOnly" Text="{Binding Bidder}" Foreground="Yellow" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="200" Margin="0,22,0,0" Grid.Row="1">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Style.Triggers>
                                <!-- 1) Y일 때만 보이게 -->
                                <DataTrigger Binding="{Binding BidderName}" Value="Y">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>

                                <!-- 2) 2줄짜리 이름이면 폰트 14 -->
                                <DataTrigger Binding="{Binding IsTwoLineName}" Value="True">
                                    <Setter Property="FontSize" Value="14"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>


                <!-- B : 윗줄 숫자, 아랫줄 이름 -->
                <StackPanel x:Name="spBidderNumberAndName" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0" Grid.Row="1">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BidderName}" Value="B">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- 윗줄 : 숫자 -->
                    <TextBlock  Foreground="Yellow" FontSize="16"  TextAlignment="Left" FontWeight="Bold" >
                        <Run Text="{Binding BidderNum}" />
                    </TextBlock>

                    <!-- 아랫줄 : 이름 (2줄 허용) -->
                    <TextBlock Text="{Binding BidderString}" Foreground="Yellow" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="80" TextWrapping="NoWrap" FontSize="11" />

                </StackPanel>
            </Grid>


            <!-- Note를 표시하는 TextBlock -->
            <Canvas x:Name="canvas" ClipToBounds="True" Margin="0,109,0,0" >
                <TextBlock x:Name="note" Text="{Binding Note}" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#f61c2d" FontWeight="Regular" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" RenderTransformOrigin="0,0"/>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
