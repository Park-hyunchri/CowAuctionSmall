<Window x:Class="CowAuctionSmall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding MainWindowWidth}" Height="{Binding MainWindowHeight, Mode=TwoWay}" Width="{Binding MainWindowWidth , Mode=TwoWay}" WindowStartupLocation="Manual" Top="{Binding MainPositionX ,Mode=TwoWay}" WindowStyle="None" Left="{Binding MainPositionY , Mode=TwoWay}" ResizeMode="NoResize" KeyDown="Window_KeyDown" Background="Black" >
    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Background="Black" >
        <Grid Background="Black">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        
        
                <!-- Content를 표시할 ContentPresenter 추가 -->
            <ContentPresenter Content="{Binding MainContainer}" Grid.Row="0"/>


            <Border Grid.Row="1" Background="#111111" Height="24" Margin="0,1,0,0" Visibility="{Binding PageIndicatorVisibility}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#404040" BorderThickness="0,0,1,0">
                        <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                            <TextBlock Foreground="#DADADA" FontSize="12" VerticalAlignment="Center" Text="응찰서버"/>
                            <Ellipse Width="9" Height="9" Fill="{Binding AuctionServerStatusBrush}" Margin="4,0,0,0" Stroke="#55000000" StrokeThickness="1"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="#404040" BorderThickness="0,0,1,0">
                        <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                            <TextBlock Foreground="#DADADA" FontSize="12" VerticalAlignment="Center" Text="{Binding PageIndicatorRoleText}"/>
                            <Ellipse Width="9" Height="9" Fill="{Binding PageIndicatorRoleBrush}" Margin="4,0,0,0" Stroke="#55000000" StrokeThickness="1"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#404040" BorderThickness="0,0,1,0">
                        <TextBlock Foreground="#DADADA" FontSize="12" Margin="8,0" VerticalAlignment="Center" Text="{Binding AuctionStatusText}"/>
                    </Border>

                    <Border Grid.Column="3" BorderBrush="#404040" BorderThickness="0,0,1,0">
                        <TextBlock Foreground="#DADADA" FontSize="12" Margin="8,0" VerticalAlignment="Center" Text="{Binding RootFarmStatusText}"/>
                    </Border>

                    <Border Grid.Column="4" BorderBrush="#404040" BorderThickness="0,0,1,0">
                        <TextBlock Foreground="#DADADA" FontSize="12" Margin="8,0" VerticalAlignment="Center" Text="{Binding CurrentPageStatusText}"/>
                    </Border>

                    <Border Grid.Column="5" Width="85" BorderBrush="#404040" BorderThickness="0,0,1,0" Visibility="{Binding PageRotationStatusVisibility}">
                        <TextBlock Foreground="#DADADA" FontSize="12" Margin="8,0" VerticalAlignment="Center" Text="{Binding PageRotationStatusText}"/>
                    </Border>

                    <TextBlock Grid.Column="6" Foreground="#DADADA" FontSize="12" Margin="8,0" VerticalAlignment="Center" Text="{Binding VersionStatusText}"/>
                </Grid>
            </Border>

            <TextBox Grid.Row="2" x:Name="MsgTextBox" Background="Black" Text="{Binding MainWindowTextBox, UpdateSourceTrigger=PropertyChanged}" Foreground="Lime" IsReadOnly="True" Margin="0,1,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"
         BorderThickness="0" BorderBrush="Transparent" Height="70" TextChanged="MsgTextBox_TextChanged"/>

        </Grid>
    </ScrollViewer>
</Window>
