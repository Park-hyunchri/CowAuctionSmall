<UserControl x:Class="CowAuctionSmall.Views.Size128_64.Running.SokchoRunning1_64"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="128">
    <UserControl.Resources>
        <Style x:Key="BlinkingBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.BorderBrush)" Duration="0:0:1">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="Black"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="Red"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource BlinkingBorderStyle}" Background="Black">
        <Canvas Width="126" Height="62">
            <TextBlock Canvas.Left="2" Canvas.Top="0" Text="개체:" Foreground="Lime" FontSize="11"/>
            <TextBlock Canvas.Left="31" Canvas.Top="0" Text="{Binding CowInfo.EntityNumber}" Foreground="{DynamicResource EntityNumberForeground}" FontSize="11"/>
            <TextBlock Canvas.Left="59" Canvas.Top="0" Text="{Binding CowInfo.EntityNumberShort}" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" FontSize="11"/>
            <TextBlock Canvas.Left="93" Canvas.Top="0" Text="{Binding CowInfo.Sex}" Foreground="DarkOrchid" FontWeight="Bold" FontSize="19"/>

            <TextBlock Canvas.Left="2" Canvas.Top="12" Text="{Binding CowInfo.Location}" Foreground="#7E84F7" FontSize="11"/>
            <TextBlock Canvas.Left="31" Canvas.Top="12" Text="{Binding CowInfo.OwnerName}" Foreground="Cyan" FontSize="11"/>

            <TextBlock Canvas.Left="2" Canvas.Top="24" Text="최저:" Foreground="Lime" FontSize="11"/>
            <TextBlock Canvas.Left="29" Canvas.Top="24" Text="{Binding CowInfo.LowestPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="Yellow" FontSize="11"/>
            <TextBlock Canvas.Left="60" Canvas.Top="24" Text="중량:" Foreground="Lime" FontSize="11"/>
            <TextBlock Canvas.Left="90" Canvas.Top="24" Text="{Binding CowInfo.Weight, Converter={StaticResource NumberFormatConverter}}" Foreground="Yellow" FontSize="11"/>

            <TextBlock Canvas.Left="2" Canvas.Top="36" Text="{Binding CowInfo.Birth}" Foreground="Cyan" FontSize="11"/>
            <Canvas x:Name="canvas" Canvas.Left="2" Canvas.Top="49" Width="120" Height="12" ClipToBounds="True">
                <TextBlock x:Name="note" Text="{Binding Note}" Foreground="Red" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </Canvas>
        </Canvas>
    </Border>
</UserControl>
