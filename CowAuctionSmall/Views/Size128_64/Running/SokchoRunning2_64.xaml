<UserControl x:Class="CowAuctionSmall.Views.Size128_64.Running.SokchoRunning2_64"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="128">
    <UserControl.Resources>
        <models:MotherLevelConverter x:Key="MotherLevelConverter"/>
    </UserControl.Resources>

    <Border BorderBrush="Black" BorderThickness="1" Background="Black">
        <Canvas Width="126" Height="62">
            <TextBlock Canvas.Left="2" Canvas.Top="0" Text="개체:" Foreground="Lime" FontSize="11"/>
            <TextBlock Canvas.Left="31" Canvas.Top="0" Text="{Binding CowInfo.EntityNumber}" Foreground="{DynamicResource EntityNumberForeground}" FontSize="11"/>
            <TextBlock Canvas.Left="59" Canvas.Top="0" Text="{Binding CowInfo.EntityNumberShort}" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" FontSize="11"/>
            <TextBlock Canvas.Left="93" Canvas.Top="0" Text="{Binding CowInfo.Sex}" Foreground="DarkOrchid" FontWeight="Bold" FontSize="19"/>

            <TextBlock Canvas.Left="2" Canvas.Top="12" Text="KPN:" Foreground="#7E84F7" FontSize="11"/>
            <TextBlock Canvas.Left="31" Canvas.Top="12" Text="{Binding CowInfo.KPN}" Foreground="Orange" FontSize="11"/>

            <TextBlock Canvas.Left="2" Canvas.Top="24" Text="산차:" Foreground="Lime" FontSize="11"/>
            <TextBlock Canvas.Left="31" Canvas.Top="24" Text="{Binding CowInfo.CalvingNumber}" Foreground="Yellow" FontSize="11"/>
            <TextBlock Canvas.Left="60" Canvas.Top="24" Text="계대:" Foreground="Lime" FontSize="11"/>
            <TextBlock Canvas.Left="89" Canvas.Top="24" Text="{Binding CowInfo.Blood}" Foreground="Yellow" FontSize="11"/>

            <TextBlock Canvas.Left="2" Canvas.Top="36" Text="어미:" Foreground="#7E84F7" FontSize="11"/>
            <TextBlock Canvas.Left="31" Canvas.Top="36" Text="{Binding CowInfo.MotherLevel, Converter={StaticResource MotherLevelConverter}}" Foreground="Orange" FontSize="11"/>
            <TextBlock Canvas.Left="60" Canvas.Top="36" Text="임신:" Foreground="#7E84F7" FontSize="11"/>
            <TextBlock Canvas.Left="89" Canvas.Top="36" Text="{Binding CowInfo.Pregnant}" Foreground="Red" FontSize="11"/>

            <Canvas x:Name="canvas" Canvas.Left="2" Canvas.Top="49" Width="120" Height="12" ClipToBounds="True">
                <TextBlock x:Name="note" Text="{Binding Note}" Foreground="Red" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </Canvas>
        </Canvas>
    </Border>
</UserControl>
