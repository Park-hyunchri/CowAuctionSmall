<UserControl x:Class="CowAuctionSmall.Views.Size128_64.SokchoSold_64"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="128">
    <UserControl.Resources>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
    </UserControl.Resources>

    <Border BorderBrush="Blue" BorderThickness="1" Background="Black">
        <Canvas Width="126" Height="62">
            <TextBlock Canvas.Left="2" Canvas.Top="0" Text="낙찰" Foreground="Violet" FontWeight="Bold" FontSize="21"/>
            <TextBlock Canvas.Left="58" Canvas.Top="3" Text="{Binding EntityNumber}" Foreground="{DynamicResource EntityNumberForeground}" FontSize="11"/>
            <TextBlock Canvas.Left="86" Canvas.Top="3" Text="{Binding EntityNumberShort}" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" FontSize="11"/>
            <TextBlock Canvas.Left="58" Canvas.Top="16" Text="{Binding OwnerName}" Foreground="Cyan" FontSize="11"/>

            <TextBlock Canvas.Left="4" Canvas.Top="32" Text="최저가" Foreground="Lime" FontSize="11"/>
            <TextBlock Canvas.Left="4" Canvas.Top="45" Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="Goldenrod" FontSize="11"/>
            <TextBlock Canvas.Left="44" Canvas.Top="32" Text="낙찰자" Foreground="Violet" FontSize="11"/>
            <TextBlock Canvas.Left="53" Canvas.Top="45" Text="{Binding Bidder}" Foreground="#FF0064" FontSize="11"/>
            <TextBlock Canvas.Left="84" Canvas.Top="32" Text="낙찰가" Foreground="Lime" FontSize="11"/>
            <TextBlock Canvas.Left="87" Canvas.Top="45" Text="{Binding BidPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="Yellow" FontSize="11"/>
        </Canvas>
    </Border>
</UserControl>
