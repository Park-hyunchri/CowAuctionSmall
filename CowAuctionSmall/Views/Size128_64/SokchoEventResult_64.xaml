<UserControl x:Class="CowAuctionSmall.Views.Size128_64.SokchoEventResult_64"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="128">
    <Border BorderBrush="Black" BorderThickness="1" Background="Black">
        <Canvas Width="126" Height="62">
            <TextBlock Canvas.Left="2" Canvas.Top="0" Text="{Binding Location}" Foreground="#7E84F7" FontSize="11"/>
            <TextBlock Canvas.Left="31" Canvas.Top="0" Text="{Binding OwnerName}" Foreground="Cyan" FontSize="11"/>

            <TextBlock Canvas.Left="2" Canvas.Top="12" Text="개체:" Foreground="Lime" FontSize="11"/>
            <TextBlock Canvas.Left="31" Canvas.Top="12" Text="{Binding EntityNumber}" Foreground="{DynamicResource EntityNumberForeground}" FontSize="11"/>
            <TextBlock Canvas.Left="59" Canvas.Top="12" Text="{Binding EntityNumberShort}" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" FontSize="11"/>

            <TextBlock Canvas.Left="2" Canvas.Top="24" Text="{Binding Birth}" Foreground="Cyan" FontSize="11"/>
            <TextBlock Canvas.Left="2" Canvas.Top="36" Text="성별:" Foreground="Lime" FontSize="11"/>
            <TextBlock Canvas.Left="29" Canvas.Top="36" Text="{Binding Sex}" Foreground="Yellow" FontSize="11"/>
            <TextBlock Canvas.Left="60" Canvas.Top="36" Text="KPN:" Foreground="#7E84F7" FontSize="11"/>
            <TextBlock Canvas.Left="90" Canvas.Top="36" Text="{Binding KPN}" Foreground="Orange" FontSize="11"/>
            <TextBlock Canvas.Left="2" Canvas.Top="49" Text="혈통번호:" Foreground="Red" FontSize="11"/>
            <TextBlock Canvas.Left="54" Canvas.Top="49" Text="{Binding BloodEntityNumber}" Foreground="Cyan" FontSize="11"/>
        </Canvas>
    </Border>
</UserControl>
