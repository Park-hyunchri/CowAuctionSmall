<UserControl x:Class="CowAuctionSmall.Views.Size128_64.SokchoUnSold_64"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Aliased"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="128">
    <UserControl.Resources>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
    </UserControl.Resources>

    <Border BorderBrush="Black" BorderThickness="1" Background="Black">
        <Canvas Width="126" Height="62">
            <TextBlock Canvas.Left="2" Canvas.Top="0" Text="{Binding Sex}" Foreground="DarkOrchid" FontWeight="Bold" FontSize="19"/>
            <TextBlock Canvas.Left="34" Canvas.Top="1" Text="개체:" Foreground="Lime" FontSize="11"/>
            <TextBlock Canvas.Left="62" Canvas.Top="1" Text="{Binding EntityNumber}" Foreground="{DynamicResource EntityNumberForeground}" FontSize="11"/>
            <TextBlock Canvas.Left="90" Canvas.Top="1" Text="{Binding EntityNumberShort}" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" FontSize="11"/>

            <TextBlock Canvas.Left="34" Canvas.Top="14" Text="최저:" Foreground="Lime" FontSize="11"/>
            <TextBlock Canvas.Left="69" Canvas.Top="14" Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}}" Foreground="Yellow" FontSize="11"/>
            <TextBlock Canvas.Left="2" Canvas.Top="27" Text="{Binding Birth}" Foreground="Cyan" FontSize="11"/>
            <TextBlock Canvas.Left="29" Canvas.Top="38" Text="유   찰" Foreground="Red" FontWeight="Bold" FontSize="15"/>
        </Canvas>
    </Border>
</UserControl>
