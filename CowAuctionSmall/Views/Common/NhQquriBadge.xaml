<UserControl x:Class="CowAuctionSmall.Views.Common.NhQquriBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Common"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="80">
    <Canvas Margin="0,13,0,0"
            RenderOptions.EdgeMode="Aliased"
            SnapsToDevicePixels="True">

        <!-- is_Nh_QQuri 가 Y일 때만 전체를 보여주기 -->
        <Canvas.Style>
            <Style TargetType="Canvas">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CowInfo.Is_Nh_QQuri}" Value="Y">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Canvas.Style>


        <!-- '뿌리' 캡슐 -->
        <Grid Canvas.Left="0" Canvas.Top="0"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True">

            <!-- 테두리 필요 없으면 주석/삭제 -->
            <!--<Rectangle RadiusX="6" RadiusY="6"
                       Stroke="Aqua" StrokeThickness="1"
                       Fill="Transparent" />-->

            <StackPanel Orientation="Horizontal" Margin="3,0,3,0">
                <TextBlock>
                    <Run Text="*" Foreground="Yellow"/>
                    <Run Text="뿌리농가" Foreground="Yellow"/>
                    <Run Text="*" Foreground="Yellow"/>
                </TextBlock>
            </StackPanel>

        </Grid>
    </Canvas>
</UserControl>
