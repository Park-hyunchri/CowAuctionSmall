<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.Standard_Goat_Run"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.Running"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <!-- 염소 러닝 페이지 -->
    <UserControl.Resources>
        <Style x:Key="BlinkingBorderStyle2" TargetType="Border">
            <Setter Property="BorderBrush" Value="black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames
                                    Storyboard.TargetProperty="(Border.BorderBrush)"
                                    Duration="0:0:1">
                                    <!-- 검정색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="Black"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>

                                    <!-- 빨간색 상태 -->
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="#FD3A4A"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 추가 -->
        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:WeightKGConverter x:Key="WeightKGConverter"/>

        <models:SelectShowWeightEpdMultiConverter x:Key="SelectShowWeightEpdMultiConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

    </UserControl.Resources>


    <Border BorderThickness="3" Style="{StaticResource BlinkingBorderStyle2}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="27"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="23"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding CowInfo.Sex}"  Style="{Binding CowInfo, Converter={StaticResource CowTypeToStyleConverter_V3}}" x:Name="Sex" Panel.ZIndex="100"/>



            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas  5:염소 6:말-->
            <TextBlock Grid.Row="0" Text="{Binding CowInfo.StrCowDistinction}" Foreground="lime" Margin="2,0,0,0" FontSize="20" FontWeight="Bold"/>
            <TextBlock Grid.Row="0" Text="{Binding CowInfo.SipNumber}" Margin="45,0,0,0" Foreground="Silver" Background="Black"  FontSize="20" FontWeight="Bold"/>
            <!-- ======================================================================================================================================================================= -->
            <TextBlock Grid.Row="1" Text="지역"  Foreground="lime"  Margin="2,0,0,0"/>
            <TextBlock Grid.Row="1" Text="{Binding CowInfo.Location}"  Foreground="lime"  Margin="30,0,0,0"/> 

            <TextBlock  Grid.Row="2" Text="출하주"  Foreground="lime"  Margin="2,0,0,0"/>
            <TextBlock  Grid.Row="2" Text=":"  Foreground="lime"  Margin="40,0,0,0"/>
            <TextBlock  Grid.Row="2" Text="{Binding CowInfo.OwnerName}" Margin="47,0,0,0" Foreground="Cyan"/>

            <TextBlock Grid.Row="3" Text="최저"  Foreground="lime"  Margin="2,0,0,0" FontSize="17"/>
            <TextBlock Grid.Row="3" Text=":"  Foreground="lime"  Margin="40,0,0,0" FontSize="17"/>
            <TextBlock Grid.Row="3" Text="{Binding CowInfo.LowestPrice, Converter={StaticResource NumberFormatConverter}}" Margin="50,0,0,0" Foreground="Yellow" FontSize="17"/>

            <!-- ======================================================================================================================================================================= -->
            <TextBlock Grid.Row="4" Text="중량" Foreground="lime" Margin="2,0,0,0" FontSize="17"/>
            <TextBlock Grid.Row="4" Text=":"  Foreground="lime"  Margin="40,0,0,0" FontSize="17"/>
            <TextBlock Grid.Row="4" Text="{Binding CowInfo.Weight, Converter={StaticResource WeightKGConverter}}" Margin="50,0,0,0" Foreground="Yellow" FontSize="17"/>

            <!-- Note를 표시하는 TextBlock -->
            <Canvas Grid.Row="5" x:Name="canvas" ClipToBounds="True" Panel.ZIndex="100" Margin="0,5,0,0">
                <TextBlock x:Name="note" Text="{Binding Note}" HorizontalAlignment="Left" Foreground="#f61c2d" FontWeight="Regular" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" RenderTransformOrigin="0,0"/>
            </Canvas>
        </Grid>
    </Border>


</UserControl>

