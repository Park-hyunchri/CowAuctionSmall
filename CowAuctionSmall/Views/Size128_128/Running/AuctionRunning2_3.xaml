<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.AuctionRunning2_3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.Running"
             xmlns:common="clr-namespace:CowAuctionSmall.Views.Common"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             Height="128" Width="128">
    <!-- NH 유전능력 -->
    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- 유전능력 목차 스타일 -->
        <Style x:Key="EpdIndexStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="lime"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 유전능력 Num 스타일 -->
        <Style x:Key="EpdNumStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="Orange"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 유전능력 Num 스타일 -->
        <Style x:Key="EpdStringStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="Silver"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Regular"/>
        </Style>

        <!-- 유전능력 Num 스타일 -->
        <Style x:Key="EpdBoarder" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Margin" Value="0,0,-1,0"/>
        </Style>


        <Style x:Key="AbcdColorStyle" TargetType="TextBlock">
            <!-- 기본 설정: 밝게 + 굵게 -->
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Silver"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Regular"/>

            <Style.Triggers>
                <!-- A: 파랑 계열 → 아주 밝은 하늘색 -->
                <Trigger Property="Text" Value="A">
                    <Setter Property="Foreground" Value="Silver"/>
                    <!-- DeepSkyBlue -->
                </Trigger>

                <!-- B: 초록 계열 → 형광 초록에 가깝게 -->
                <Trigger Property="Text" Value="B">
                    <Setter Property="Foreground" Value="Silver"/>
                    <!-- Lime -->
                </Trigger>

                <!-- C: 주황 계열 → 더 밝은 주황/노랑 사이 -->
                <Trigger Property="Text" Value="C">
                    <Setter Property="Foreground" Value="Silver"/>
                    <!-- Orange -->
                </Trigger>

                <!-- D: 빨강 계열 → 아주 진한 빨강 -->
                <Trigger Property="Text" Value="D">
                    <Setter Property="Foreground" Value="Silver"/>
                    <!-- Red -->
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 뿌리농가 벳지 표출 (뱃지 UI 컴포넌트: Views\Common\NhQquriBadge.xaml)-->
        <common:NhQquriBadge x:Key="NhQquriBadge" />

    </UserControl.Resources>
    <Grid Background="Black">

        <!-- "유전능력 EPD"을 표시하는 TextBlock -->
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Text="유 전 능 력" FontSize="16" Foreground="Violet" FontWeight="Bold" Margin="0,0,0,0"/>
        <common:NhQquriBadge HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-80,3,0,0"   LabelText="뿌리 농가" LabelFontSize="13" LabelForeground="Yellow" />

        <Grid Margin="2,30,2,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="17"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="2"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>


            <TextBlock Grid.Row="0" Grid.Column="0" Text="냉도체중"  Style="{StaticResource EpdIndexStyle}" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text=":"  Style="{StaticResource EpdIndexStyle}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CowInfo.bodyWeightInColdNum}"  Style="{StaticResource EpdNumStyle}"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding CowInfo.bodyWeightInColdString}"  Style="{StaticResource AbcdColorStyle}"/>


            <TextBlock Grid.Row="1" Grid.Column="0" Text="배최장근"  Style="{StaticResource EpdIndexStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text=":"  Style="{StaticResource EpdIndexStyle}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CowInfo.longestMuscleCrossSectionNum}"  Style="{StaticResource EpdNumStyle}"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding CowInfo.longestMuscleCrossSectionString}" Style="{StaticResource AbcdColorStyle}"/>


            <TextBlock Grid.Row="2" Grid.Column="0" Text="등 지 방 "  Style="{StaticResource EpdIndexStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text=":"  Style="{StaticResource EpdIndexStyle}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CowInfo.fatThicknessOnBackNum}" Style="{StaticResource EpdNumStyle}"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding CowInfo.fatThicknessOnBackString}" Style="{StaticResource AbcdColorStyle}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="근내지방"  Style="{StaticResource EpdIndexStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text=":"  Style="{StaticResource EpdIndexStyle}"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CowInfo.intramuscularFatContentNum}"  Style="{StaticResource EpdNumStyle}"/>
            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding CowInfo.intramuscularFatContentString}" Style="{StaticResource AbcdColorStyle}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Text="--------------------------------"  Style="{StaticResource EpdIndexStyle}" HorizontalAlignment="Center"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="임신수정일"  Style="{StaticResource EpdIndexStyle}" Foreground="HotPink"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text=":"  Style="{StaticResource EpdIndexStyle}" Foreground="HotPink"/>
            <TextBlock Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding CowInfo.Reproduction_Imsin_Sujung_Date}"  Style="{StaticResource EpdIndexStyle}" Foreground="Yellow" HorizontalAlignment="Center"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="수정 KPN"  Style="{StaticResource EpdIndexStyle}" Foreground="HotPink"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Text=":"  Style="{StaticResource EpdIndexStyle}" Foreground="HotPink" />
            <TextBlock Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding CowInfo.Reproduction_Sujung_KPN}"  Style="{StaticResource EpdIndexStyle}" Foreground="OrangeRed" HorizontalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
