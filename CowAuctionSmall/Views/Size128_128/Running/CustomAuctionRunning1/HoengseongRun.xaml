<UserControl x:Class="CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1.HoengseongRun"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.Running.CustomAuctionRunning1"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">

    <UserControl.Resources>
        <!-- 진행 중 테두리 깜박임 스타일 -->
        <Style x:Key="BlinkingBorderStyle2" TargetType="Border">
            <Setter Property="BorderBrush" Value="black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.BorderBrush)" Duration="0:0:1">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="Black"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6">
                                        <DiscreteObjectKeyFrame.Value>
                                            <SolidColorBrush Color="#FD3A4A"/>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:MotherLevelConverter x:Key="MotherLevelConverter" />
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>

        <Style x:Key="DistributionEventHiddenTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CowInfo.LowestPriceTitle}" Value="행사용">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Border BorderThickness="2" Style="{StaticResource BlinkingBorderStyle2}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="black">
        <Canvas Width="124" Height="124">

            <!-- 우측 암/수/거세 성별 표출 -->
            <TextBlock Text="{Binding CowInfo.Sex}" Style="{Binding CowInfo, Converter={StaticResource CowTypeToStyleConverter_V3}}" Canvas.Left="78" Canvas.Top="0" Width="46" Margin="0" TextAlignment="Right">
                <TextBlock.RenderTransform>
                    <TranslateTransform Y="17"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- 1행: 개체번호 라인 (Y=0) -->
            <TextBlock Text="개체:" Foreground="lime" Canvas.Left="2" Canvas.Top="0" FontSize="13"/>
            <TextBlock Text="{Binding CowInfo.EntityNumber}" Foreground="{DynamicResource EntityNumberForeground}" Canvas.Left="42" Canvas.Top="0" FontSize="13"/>
            <TextBlock Text="{Binding CowInfo.EntityNumberShort}" Foreground="Red" Background="Black" Canvas.Left="74" Canvas.Top="0" FontSize="13"/>

            <!-- 2행: 출하지역 / 농가명 (Y=16) -->
            <TextBlock Style="{StaticResource DistributionEventHiddenTextStyle}" Canvas.Left="2" Canvas.Top="16" Foreground="{DynamicResource LocationForeground}" FontSize="13" Text="{Binding CowInfo.Location}"/>
            <TextBlock Style="{StaticResource DistributionEventHiddenTextStyle}" Canvas.Left="35" Canvas.Top="16" Foreground="Cyan" FontSize="13" Text="{Binding CowInfo.OwnerName}"/>

            <!-- 3행: 내정가 / 최저가 (Y=32) -->
            <TextBlock Canvas.Left="2" Canvas.Top="32" Foreground="lime" FontSize="13" Text="{Binding CowInfo.LowestPriceTitleShort}"/>
            <TextBlock Canvas.Left="43" Canvas.Top="32" Foreground="Yellow" FontSize="13" Text="{Binding CowInfo.LowestPrice, Converter={StaticResource NumberFormatConverter}}"/>

            <!-- 4행: 중량 및 임신 (Y=48) -->
            <TextBlock Canvas.Left="2" Canvas.Top="48" Foreground="lime" FontSize="13">
                <Run Text="중량:"/>
                <Run Text="{Binding CowInfo.Weight, Converter={StaticResource NumberFormatConverter}}" Foreground="Yellow"/>
            </TextBlock>
            <TextBlock Style="{StaticResource DistributionEventHiddenTextStyle}" Canvas.Left="68" Canvas.Top="48" Foreground="lime" FontSize="13">
                <Run Text="임신:"/>
                <Run Text="{Binding CowInfo.Pregnant}" Foreground="Red"/>
            </TextBlock>

            <!-- 5행: 생년월일 (Y=64) -->
            <TextBlock Text="{Binding CowInfo.Birth}" Foreground="Cyan" Canvas.Left="2" Canvas.Top="64" FontSize="13"/>

            <!-- 6행: 어미 / 계대 (Y=80) -->
            <TextBlock Canvas.Left="2" Canvas.Top="80" Foreground="lime" FontSize="13">
                <Run Text="어미:"/>
                <Run Text="{Binding CowInfo.MotherLevel, Converter={StaticResource MotherLevelConverter}}" Foreground="Orange"/>
            </TextBlock>
            <TextBlock Canvas.Left="68" Canvas.Top="80" Foreground="lime" FontSize="13">
                <Run Text="계대:"/>
                <Run Text="{Binding CowInfo.Blood}" Foreground="Orange"/>
            </TextBlock>

            <!-- 7행: KPN / 산차 (Y=96) -->
            <TextBlock Canvas.Left="2" Canvas.Top="96" Foreground="lime" FontSize="13">
                <Run Text="KPN:"/>
                <Run Text="{Binding CowInfo.KPN}" Foreground="Orange"/>
            </TextBlock>
            <TextBlock Canvas.Left="68" Canvas.Top="96" Foreground="lime" FontSize="13">
                <Run Text="산차:"/>
                <Run Text="{Binding CowInfo.CalvingNumber}" Foreground="Orange"/>
            </TextBlock>

        </Canvas>
    </Border>
</UserControl>
