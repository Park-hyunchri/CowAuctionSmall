<UserControl x:Class="CowAuctionSmall.Views.Size128_128.CustomAuctionUnSold.JangseongUnSold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.CustomAuctionUnSold"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             Height="128" Width="128">


    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>


        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:WeightKGConverter x:Key="WeightKGConverter"/>
        <models:NH_EPD_ShowToVisibilityConverter x:Key="NH_EPD_ShowToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <models:SelectShowWeightEpdMultiConverter x:Key="SelectShowWeightEpdMultiConverter"/>
    </UserControl.Resources>

    <Grid Background="black">
        <Border BorderThickness="2" BorderBrush="OrangeRed"/>
        <Grid>
            <!-- "유찰"을 표시하는 TextBlock -->
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Text="유    찰" FontSize="25" Foreground="#e5081b" FontWeight="Bold"/>

            <TextBlock Text="{Binding Sex}" Style="{Binding CopyGValues, Converter={StaticResource CowTypeToStyleConverter_V3}}" VerticalAlignment="Top" x:Name="Sex">
                <TextBlock.RenderTransform>
                    <TranslateTransform Y="30"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock Margin="2,30,0,0">
                <Run Text="최저 : " Foreground="lime"/>
                <Run Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}, StringFormat=' {0}'}" Foreground="Yellow"/>
            </TextBlock>

            <!-- 어미 표시용 -->
            <TextBlock Margin="2,60,0,0">
                <Run Text="어미 :" Foreground="lime"/>
                <Run Text="002" Foreground="Yellow"/>
                <Run Text="{Binding MatherEntityNumber}" Foreground="Yellow"/>
            </TextBlock>


            <!-- 중량 표시용 -->
            <TextBlock Margin="2,45,0,0">
                <Run Text="{Binding Location}" Foreground="{DynamicResource LocationForeground}"/>
                <Run Text="{Binding OwnerName}" Foreground="Cyan"/>
            </TextBlock>

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
            <TextBlock Margin="2,75,2,2" Text="{Binding StrCowDistinction}" Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction"/>
            <TextBlock Margin="44,75,2,2" Text="{Binding EntityNumber}" Foreground="{DynamicResource EntityNumberForeground}"/>
            <TextBlock Margin="44,75,2,2" Text="{Binding EntityNumberShort}" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" Width="26"/>
            <!-- ======================================================================================================================================================================= -->

            <TextBlock Margin="2,90,0,0" Text="{Binding Birth}" Foreground="Cyan"/>


        </Grid>

    </Grid>

</UserControl>
