<UserControl x:Class="CowAuctionSmall.Views.Size128_128.CustomAUctionUnSold.YecheonUnSold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.CustomAUctionUnSold"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             Height="128" Width="128">

    <!-- 예천축협 유찰 페이지 적용 -->
    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="AbcdColorStyle" TargetType="TextBlock">
            <!-- 기본 설정: 밝게 + 굵게 -->
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="Silver"/>

            <Style.Triggers>
                <!-- A: 파랑 계열 → 아주 밝은 하늘색 -->
                <Trigger Property="Text" Value="A">
                    <Setter Property="Foreground" Value="#00BFFF"/>
                    <!-- DeepSkyBlue -->
                </Trigger>

                <!-- B: 초록 계열 → 형광 초록에 가깝게 -->
                <Trigger Property="Text" Value="B">
                    <Setter Property="Foreground" Value="#00FF00"/>
                    <!-- Lime -->
                </Trigger>

                <!-- C: 주황 계열 → 더 밝은 주황/노랑 사이 -->
                <Trigger Property="Text" Value="C">
                    <Setter Property="Foreground" Value="#FFA500"/>
                    <!-- Orange -->
                </Trigger>

                <!-- D: 빨강 계열 → 아주 진한 빨강 -->
                <Trigger Property="Text" Value="D">
                    <Setter Property="Foreground" Value="#FF0000"/>
                    <!-- Red -->
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 1번 능력 -->
        <Style x:Key="NhAbility1Style" TargetType="TextBlock" BasedOn="{StaticResource AbcdColorStyle}">
            <!-- 기본: CowDistinction != 3 일 때 -->
            <Setter Property="Margin" Value="60,0,0,0"/>
        </Style>

        <!-- 2번 능력 -->
        <Style x:Key="NhAbility2Style" TargetType="TextBlock" BasedOn="{StaticResource AbcdColorStyle}">
            <Setter Property="Margin" Value="70,0,0,0"/>
        </Style>

        <!-- 3번 능력 -->
        <Style x:Key="NhAbility3Style" TargetType="TextBlock" BasedOn="{StaticResource AbcdColorStyle}">
            <Setter Property="Margin" Value="80,0,0,0"/>
        </Style>

        <!-- 4번 능력 -->
        <Style x:Key="NhAbility4Style" TargetType="TextBlock" BasedOn="{StaticResource AbcdColorStyle}">
            <Setter Property="Margin" Value="90,0,0,0"/>
        </Style>


        <models:CowTypeToStyleConverter_OutLine_V3 x:Key="CowTypeToStyleConverter_OutLine_V3"/>
        <models:NhLabelConverter x:Key="NhLabelConverter"/>
        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
        <models:WeightKGConverter x:Key="WeightKGConverter"/>
        <models:NH_EPD_ShowToVisibilityConverter x:Key="NH_EPD_ShowToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <models:SelectShowWeightEpdMultiConverter x:Key="SelectShowWeightEpdMultiConverter"/>
    </UserControl.Resources>

    <Grid Background="black">
        <Border BorderThickness="2" BorderBrush="OrangeRed"/>
        <Grid>
            <!-- "유찰"을 표시하는 TextBlock -->
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Text="유    찰" FontSize="25" Foreground="#e5081b" FontWeight="Bold"/>

            <!-- 예천 혈통인경우 테두리 CowTypeToStyleConverter_OutLine_V3-->
            <Canvas Margin="0,30,0,85">
                <ContentControl>
                    <ContentControl.Content>
                        <MultiBinding Converter="{StaticResource CowTypeToStyleConverter_OutLine_V3}">
                            <Binding Path="Sex"/>
                            <Binding Path="RegistrationCategory"/>
                        </MultiBinding>
                    </ContentControl.Content>
                </ContentControl>
            </Canvas>

            <TextBlock Margin="2,30,0,0">
                <Run Text="최저 : " Foreground="lime"/>
                <Run Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}, StringFormat=' {0}'}" Foreground="Yellow"/>
            </TextBlock>

            <TextBlock Margin="2,60,2,50">
                <Run Text="출하주 : " Foreground="lime"/>
                <Run Text="{Binding OwnerName}" Foreground="Cyan"/>
            </TextBlock>

            <!-- 중량 표시용 -->
            <TextBlock Margin="2,45,0,0">
                <Run Text="중량 : " Foreground="lime"/>
                <Run Text="{Binding Weight, StringFormat=' {0}'}" Foreground="Yellow"/>
            </TextBlock>

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
            <TextBlock Margin="0,75,2,2" Text="{Binding StrCowDistinction}" Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction"/>
            <TextBlock Margin="44,75,2,2" Text="{Binding EntityNumber}" Foreground="{DynamicResource EntityNumberForeground}"/>
            <TextBlock Margin="44,75,2,2" Text="{Binding EntityNumberShort}" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" Width="26"/>
            <!-- ======================================================================================================================================================================= -->

            <TextBlock Margin="2,90,0,0" Text="{Binding Birth}" Foreground="Cyan"/>

        </Grid>
    </Grid>

</UserControl>
