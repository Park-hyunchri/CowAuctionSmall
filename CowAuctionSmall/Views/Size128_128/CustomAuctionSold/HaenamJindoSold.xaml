<UserControl x:Class="CowAuctionSmall.Views.Size128_128.CustomAuctionSold.HaenamJindoSold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CowAuctionSmall.Views.Size128_128.CustomAuctionSold"
                                       xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             xmlns:common="clr-namespace:CowAuctionSmall.Views.Common"
             FontFamily="굴림"
             TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <!-- 해남진도 낙찰페이지 적용 -->
    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <models:CowTypeToStyleConverter_V3 x:Key="CowTypeToStyleConverter_V3"/>
        <models:EntityNumberPartConverter x:Key="EntityNumberPartConverter"/>
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
        <models:CowCowDist_NumToString x:Key="CowCowDist_NumToString"/>
    </UserControl.Resources>

    <Border BorderBrush="Blue" BorderThickness="2">

        <Grid Background="Black">
            <TextBlock Visibility="Collapsed" Text="{Binding CowDistinction}" />
            <!-- "낙찰"을 표시하는 TextBlock -->
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Text="낙    찰" FontSize="25" Foreground="Violet" />

            <Canvas Margin="0,30,0,0">
                <TextBlock Text="최저가 : "  Foreground="lime"  Margin="2,0,0,0" FontSize="13"/>
                <TextBlock Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}}" Margin="60,0,0,0" Foreground="#FFA500" FontSize="13"/>
            </Canvas>

            <Canvas Margin="0,45,0,0">
                <TextBlock Text="낙찰가 : "  Foreground="lime"  Margin="2,0,0,0" FontSize="13"/>
                <TextBlock Text="{Binding BidPrice, Converter={StaticResource NumberFormatConverter}}" Margin="60,0,0,0" Foreground="Yellow" FontSize="13"/>
                <!--#87CEEB -->
            </Canvas>

            <Canvas Margin="0,60,0,0" >
                <TextBlock Text="낙찰자 : "  Foreground="Violet"  Margin="2,0,0,0" FontSize="13"/>
                <Canvas x:Name="canvasBidder" ClipToBounds="True" Height="15" HorizontalAlignment="Left" Canvas.Left="60" VerticalAlignment="Center" Width="64">
                    <TextBlock x:Name="bidder" Text="{Binding Bidder}" Foreground="Cyan" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BidderName}" Value="Y">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BidderName}" Value="B">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <common:BidderNameFlow Text="{Binding BidderString}" Width="64" Height="15" Foreground="Cyan" FontSize="13">
                        <common:BidderNameFlow.Style>
                            <Style TargetType="{x:Type common:BidderNameFlow}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BidderName}" Value="Y">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BidderName}" Value="B">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </common:BidderNameFlow.Style>
                    </common:BidderNameFlow>
                    <!--#FF69B4 -->
                </Canvas>
            </Canvas>

            <!-- ======================================================================================================================================================================= -->
            <!-- CowDistinction 값이 "1", "2", "3"인 경우 보이는 소 Canvas -->
            <Canvas Margin="0,75,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="{Binding StrCowDistinction}"   Style="{Binding StrCowDistinction, Converter={StaticResource CowCowDist_NumToString}}" x:Name="StrCowDistinction"/>
                <TextBlock Margin="44,0,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource EntityNumberForeground}"><Run Text="{Binding EntityNumber, Converter={StaticResource EntityNumberPartConverter}, ConverterParameter=First}"/><Run Text=" "/><Run Text="{Binding EntityNumberShort}" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" FontWeight="Normal"/><Run Text=" "/><Run Text="{Binding EntityNumber, Converter={StaticResource EntityNumberPartConverter}, ConverterParameter=Last}"/></TextBlock>
            </Canvas>
            <!-- CowDistinction 값이 "5"인 경우 보이는 염소 Canvas -->
            <Canvas Margin="0,75,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
                <TextBlock Text="개체 : " Foreground="lime" Margin="2,0,0,0" />
                <TextBlock Text="{Binding SipNumber}" Margin="40,0,0,0" Foreground="Silver" Background="Black" FontWeight="Bold"/>
            </Canvas>
            <!-- ======================================================================================================================================================================= -->

            <Canvas Margin="0,90,0,0">
                <TextBlock Text="{Binding Location}"  Foreground="{DynamicResource LocationForeground}" Margin="2,0,0,0" />
                <TextBlock Text="{Binding OwnerName}" Margin="35,0,0,0" Foreground="Silver"/>
            </Canvas>

        </Grid>
    </Border>
</UserControl>
