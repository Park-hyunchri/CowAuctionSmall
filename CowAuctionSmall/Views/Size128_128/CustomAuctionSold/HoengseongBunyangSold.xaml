<UserControl x:Class="CowAuctionSmall.Views.Size128_128.CustomAuctionSold.HoengseongBunyangSold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:CowAuctionSmall.Models.Converter"
             FontFamily="굴림" FontWeight="Bold" TextOptions.TextFormattingMode="Display"
             mc:Ignorable="d" d:DesignHeight="128" d:DesignWidth="128">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <models:EntityNumberVisibilityConverter x:Key="EntityNumberVisibilityConverter"/>
        <models:NumberFormatConverter x:Key="NumberFormatConverter"/>
    </UserControl.Resources>
    <Border BorderBrush="Blue" BorderThickness="2">
        <Grid Background="Black">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Text="분    양" FontSize="22" Foreground="Violet" Margin="0,-1,0,0"/>
            <Canvas Margin="0,22,0,0">
                <TextBlock Text="분양가:" Foreground="lime" Margin="2,0,0,0" FontSize="13"/>
                <TextBlock Text="{Binding LowestPrice, Converter={StaticResource NumberFormatConverter}}" Margin="55,0,0,0" Foreground="#FFA500" FontSize="14"/>
            </Canvas>
            <Canvas Margin="0,40,0,0">
                <TextBlock Text="당첨자:" Foreground="Violet" Margin="2,0,0,0" FontSize="13"/>
                <StackPanel Orientation="Vertical" Canvas.Left="55">
                    <TextBlock Text="{Binding BidderString}" Foreground="Silver" FontSize="13"/>
                    <TextBlock Text="{Binding BidderNum, StringFormat='({0})'}" Foreground="Silver" FontSize="13" Margin="0,1,0,0"/>
                </StackPanel>
            </Canvas>
            <Canvas Margin="0,74,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Cow}">
                <TextBlock Text="개체:" Foreground="lime" Margin="2,0,0,0" FontSize="13"/>
                <TextBlock Text="{Binding EntityNumber}" Margin="40,0,0,0" Foreground="{DynamicResource EntityNumberForeground}" FontSize="13"/>
                <TextBlock Text="{Binding EntityNumberShort}" Margin="77,0,0,0" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" FontSize="13"/>
            </Canvas>
            <Canvas Margin="0,74,0,0" Visibility="{Binding CowDistinction, Converter={StaticResource EntityNumberVisibilityConverter}, ConverterParameter=Goat}">
                <TextBlock Text="개체:" Foreground="lime" Margin="2,0,0,0" FontSize="13"/>
                <TextBlock Text="{Binding EntityNumberShort}" Margin="40,0,0,0" Foreground="{DynamicResource EntityNumberShortForeground}" Background="{DynamicResource EntityNumberShortBackground}" FontSize="13"/>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
